@model APRsystem.ViewModels.EditUserRoleViewModel

@{
    ViewData["Title"] = "Edit User Role";
}

<h2>Edit Role for @Model.FullName</h2>
<p><strong>Email:</strong> @Model.Email</p>
<p><strong>Current Role:</strong> @Model.CurrentRole</p>

<form asp-action="EditUserRole" method="post">
    <input type="hidden" name="id" value="@Model.UserId" />

    <div class="form-group mb-3">
        <label for="selectedRole">Select New Role</label>
        <select name="selectedRole" class="form-select" id="selectedRole">
            @foreach (var role in Model.AvailableRoles)
            {
                if (role == Model.SelectedRole)
                {
                    <option value="@role" selected>@role</option>
                }
                else
                {
                    <option value="@role">@role</option>
                }
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save Role</button>
    <a asp-action="ManageUsers" class="btn btn-secondary">Cancel</a>
</form>