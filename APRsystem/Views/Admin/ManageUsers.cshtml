@model IEnumerable<APRsystem.ViewModels.ManageUserRolesViewModel>

@{
    ViewData["Title"] = "Manage Users";
}

<h2 class="mb-4">Manage Users</h2>

<table class="table table-dark table-bordered table-hover">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Current Role</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

    @foreach (var user in Model)
    {
        <tr>
            <td>@user.FullName</td>
            <td>@user.Email</td>
            <td>@user.CurrentRole</td>
            <td>
                <a asp-action="EditUserRole"
                   asp-route-id="@user.UserId"
                   class="btn btn-primary btn-sm">
                    Change Role
                </a>
            </td>
        </tr>
    }

    </tbody>

</table>