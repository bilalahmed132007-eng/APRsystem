@model APRsystem.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold mb-1">Admin Dashboard</h2>
            <p class="text-muted mb-0">
                Welcome back! Manage users, roles, and permissions from one place.
            </p>
        </div>

        <span class="badge bg-success fs-6 px-3 py-2 shadow-sm">
            System Online
        </span>
    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-5">

        <!-- Total Users -->
        <div class="col-lg-6">
            <div class="card border-0 shadow rounded-4 dashboard-card h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-2 fw-semibold">
                                Total Users
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.TotalUsers
                            </h2>
                        </div>

                        <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                            <i class="bi bi-people-fill text-primary fs-2"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Active Users -->
        <div class="col-lg-6">
            <div class="card border-0 shadow rounded-4 dashboard-card h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-2 fw-semibold">
                                Active Users
                            </p>

                            <h2 class="fw-bold mb-0 text-success">
                                @Model.ActiveUsers
                            </h2>
                        </div>

                        <div class="bg-success bg-opacity-10 rounded-circle p-3">
                            <i class="bi bi-person-check-fill text-success fs-2"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Management Section -->
    <div class="mb-4">
        <h3 class="fw-bold">Administration</h3>
        <p class="text-muted">
            Manage roles, permissions, and user accounts.
        </p>
    </div>

    <div class="row g-4">

        <!-- Roles -->
        <div class="col-lg-4 col-md-6">

            <div class="card border-0 shadow rounded-4 dashboard-card h-100">

                <div class="card-body text-center p-4">

                    <div class="mb-3">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center"
                             style="width:80px;height:80px;">
                            <i class="bi bi-shield-lock-fill text-primary fs-1"></i>
                        </div>
                    </div>

                    <h4 class="fw-bold">
                        Manage Roles
                    </h4>

                    <p class="text-muted">
                        Create, edit, and organize system roles.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Roles"
                       class="btn btn-primary rounded-pill px-4">
                        Open
                    </a>

                </div>

            </div>

        </div>

        <!-- Permissions -->
        <div class="col-lg-4 col-md-6">

            <div class="card border-0 shadow rounded-4 dashboard-card h-100">

                <div class="card-body text-center p-4">

                    <div class="mb-3">
                        <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center"
                             style="width:80px;height:80px;">
                            <i class="bi bi-key-fill text-success fs-1"></i>
                        </div>
                    </div>

                    <h4 class="fw-bold">
                        Manage Permissions
                    </h4>

                    <p class="text-muted">
                        Control what each role is allowed to access.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Permissions"
                       class="btn btn-success rounded-pill px-4">
                        Open
                    </a>

                </div>

            </div>

        </div>

        <!-- Users -->
        <div class="col-lg-4 col-md-6">

            <div class="card border-0 shadow rounded-4 dashboard-card h-100">

                <div class="card-body text-center p-4">

                    <div class="mb-3">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex justify-content-center align-items-center"
                             style="width:80px;height:80px;">
                            <i class="bi bi-person-gear text-warning fs-1"></i>
                        </div>
                    </div>

                    <h4 class="fw-bold">
                        Manage Users
                    </h4>

                    <p class="text-muted">
                        View and manage employee accounts.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ManageUsers"
                       class="btn btn-warning rounded-pill px-4">
                        Open
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>