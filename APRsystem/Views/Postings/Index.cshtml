@model IEnumerable<APRsystem.Models.Posting>

@{
    ViewData["Title"] = "Postings";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Postings</h2>
            <small class="text-muted">Track where each employee is currently assigned</small>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
        {
            <a asp-action="Create" class="btn btn-danger px-4">
                <i class="bi bi-plus-circle me-2"></i>
                New Posting
            </a>
        }
    </div>

    <div class="card shadow-sm border-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Supervisor</th>
                        <th>Location</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Employee?.FullName</td>
                            <td>@(item.Department?.Name ?? "-")</td>
                            <td>@(item.Designation?.Value ?? "-")</td>
                            <td>@(item.Supervisor?.FullName ?? "-")</td>
                            <td>@(item.Location?.Name ?? "-")</td>
                            <td>@item.FromDate.ToString("dd MMM yyyy")</td>
                            <td>@(item.ToDate?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge-active">Current</span>
                                }
                                else
                                {
                                    <span class="badge-inactive">Ended</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-chip btn-chip-view">View</a>

                                    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-chip btn-chip-edit">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-chip btn-chip-delete">Delete</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>