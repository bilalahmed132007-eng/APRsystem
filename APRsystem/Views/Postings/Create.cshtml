@model APRsystem.ViewModels.CreatePostingViewModel

@{
    ViewData["Title"] = "Create Posting";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Create Posting</h2>
            <small class="text-muted">
                Assign an employee to a department, designation, and location.
            </small>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Back to Postings
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>
            }
            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- ContractId is resolved server-side from whichever employee is picked above.
                     The value here is only used to prefill the form after a failed submit;
                     the POST action re-derives it from EmployeeId regardless. -->
                <input type="hidden" asp-for="ContractId" id="ContractId" />

                <div class="row">

                    <div class="col-md-6">

                        <div class="mb-3">
                            <label class="form-label">Employee</label>
                            <select asp-for="EmployeeId" id="EmployeeId" class="form-select" asp-items="ViewBag.EmployeeId">
                                <option value="">Select Employee</option>
                            </select>
                            <span asp-validation-for="EmployeeId" class="text-danger"></span>
                        </div>

                        <small id="ContractWarning" class="text-danger d-none mb-3 d-block">
                            This employee has no active contract.
                        </small>

                        <div class="mb-3">
                            <label class="form-label">Department</label>
                            <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.DepartmentId">
                                <option value="">Select Department</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Designation</label>
                            <select asp-for="DesignationId" class="form-select" asp-items="ViewBag.DesignationId">
                                <option value="">Select Designation</option>
                            </select>
                            <span asp-validation-for="DesignationId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Supervisor</label>
                            <select asp-for="SupervisorId" class="form-select" asp-items="ViewBag.SupervisorId">
                                <option value="">No Supervisor</option>
                            </select>
                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="mb-3">
                            <label class="form-label">Location</label>
                            <select asp-for="LocationId" class="form-select" asp-items="ViewBag.LocationId">
                                <option value="">Select Location</option>
                            </select>
                            <span asp-validation-for="LocationId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Salary" class="form-label"></label>
                            <input asp-for="Salary" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Salary" class="text-danger"></span>
                        </div>

                        
                        <div class="mb-3">
                            <label asp-for="FromDate" class="form-label"></label>
                            <input asp-for="FromDate" type="date" class="form-control" id="FromDate" />
                            <span asp-validation-for="FromDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ToDate" class="form-label"></label>
                            <input asp-for="ToDate" type="date" class="form-control" id="ToDate" />
                            <small class="text-muted d-block mt-1">
                                Defaults to the selected employee's contract end date. Leave blank if open-ended.
                            </small>
                            <span asp-validation-for="ToDate" class="text-danger"></span>
                            <div class="form-check mt-3">
                                <input asp-for="KeepPreviousPostingKPIs" class="form-check-input" />
                                <label asp-for="KeepPreviousPostingKPIs" class="form-check-label"></label>

                                <small class="text-muted d-block">
                                    Copies the Posting-Specific KPIs from the employee's previous posting.
                                </small>
                            </div>

                        </div>

                    </div>
                    <div class="mt-4 d-flex justify-content-end">
                        <button type="submit" class="btn btn-danger px-5">
                            Create Posting
                        </button>
                    </div>

                
                </form>

            </div>
        </div>

    </div>

    <!-- Template for a single KPI row (cloned by JS) -->
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }

        <script>
            (function() {
                const employeeSelect = document.getElementById('EmployeeId');
                const contractIdInput = document.getElementById('ContractId');
                const contractWarning = document.getElementById('ContractWarning');
                const toDateInput = document.getElementById('ToDate');

                // Only auto-fill ToDate if the user hasn't already typed something in themselves
                // (also true right after we auto-fill it once, which is fine — re-picking the
                // employee should refresh it).
                let toDateWasAutoFilled = true;

                toDateInput.addEventListener('input', function() {
                    toDateWasAutoFilled = false;
                });

                employeeSelect.addEventListener('change', async function() {
                    const employeeId = this.value;

                    contractIdInput.value = '';
                    contractWarning.classList.add('d-none');

                    if (!employeeId) {
                        return;
                    }

                    try {
                        const response = await fetch(`@Url.Content("~/Postings/GetActiveContract")/${employeeId}`, {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        if (!response.ok) {
                            throw new Error('Request failed');
                        }

                        const data = await response.json();

                        if (!data.found) {
                            contractWarning.classList.remove('d-none');
                            contractIdInput.value = '';
                            return;
                        }

                        contractIdInput.value = data.contractId;

                        if (toDateWasAutoFilled) {
                            toDateInput.value = data.endDate || '';
                        }
                    } catch (err) {
                        // Silent fail — ContractId will still be re-derived server-side on submit.
                    }
                });
            })();
        </script>
    }
