@model APRsystem.ViewModels.PostingDetailsViewModel

@{
    ViewData["Title"] = "Posting Details";
    var posting = Model.Posting;
}

<div class="container py-4">

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Posting Details</h2>
            <small class="text-muted">@posting.Employee?.FullName · @(posting.Designation?.Value ?? "-")</small>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Back to Postings
        </a>
    </div>

    @* ---------- Posting-Specific KPIs: moved to the top, this is the actionable content ---------- *@
    <div class="card shadow-sm border-0 mb-4" id="specific-kpis">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h4 class="mb-1">
                        <i class="bi bi-bullseye me-2 text-primary"></i>
                        Posting-Specific KPIs
                    </h4>
                    <small class="text-muted">
                        Custom to this posting. Required before an appraisal can be initiated.
                    </small>
                </div>

                <a asp-controller="PostingKPIs"
                   asp-action="Create"
                   asp-route-postingId="@Model.Posting.Id"
                   class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Add KPI
                </a>
            </div>

            @if (Model.AssignedKPIs.Any())
            {
                <table class="table table-bordered mb-0">
                    <thead>
                        <tr>
                            <th>KPI Title</th>
                            <th>Weight</th>
                            <th>Status</th>
                            <th width="180">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.AssignedKPIs)
                        {
                            <tr>
                                <td>
                                    @item.Title
                                    <br />
                                    <small class="text-muted">@item.Description</small>
                                </td>
                                <td>@item.Weight</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="PostingKPIs"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <a asp-controller="PostingKPIs"
                                       asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-exclamation-triangle text-warning" style="font-size: 28px;"></i>
                    <p class="text-muted mt-2 mb-0">
                        No Posting-Specific KPIs assigned yet. Add at least one before initiating an appraisal.
                    </p>
                </div>
            }

        </div>
    </div>

    @* ---------- Posting info: reference data, compact grid instead of a long dl list ---------- *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h6 class="text-muted mb-3">
                <i class="bi bi-info-circle me-1"></i> Posting Information
            </h6>

            <div class="row g-3">
                <div class="col-sm-4 col-lg-3">
                    <div class="text-muted small">Employee</div>
                    <div class="fw-semibold">@(posting.Employee?.FullName ?? "—")</div>
                </div>
                <div class="col-sm-4 col-lg-3">
                    <div class="text-muted small">Contract</div>
                    <div class="fw-semibold">@(posting.Contract?.ContractNumber ?? "—")</div>
                </div>
                <div class="col-sm-4 col-lg-3">
                    <div class="text-muted small">Department</div>
                    <div class="fw-semibold">@(posting.Department?.Name ?? "—")</div>
                </div>
                <div class="col-sm-4 col-lg-3">
                    <div class="text-muted small">Designation</div>
                    <div class="fw-semibold">@(posting.Designation?.Value ?? "—")</div>
                </div>
                <div class="col-sm-4 col-lg-3">
                    <div class="text-muted small">Supervisor</div>
                    <div class="fw-semibold">@(posting.Supervisor?.FullName ?? "—")</div>
                </div>
                <div class="col-sm-4 col-lg-3">
                    <div class="text-muted small">Location</div>
                    <div class="fw-semibold">@(posting.Location?.Name ?? "—")</div>
                </div>
                <div class="col-sm-4 col-lg-3">
                    <div class="text-muted small">Salary</div>
                    <div class="fw-semibold">@posting.Salary.ToString("N0")</div>
                </div>
                <div class="col-sm-4 col-lg-3">
                    <div class="text-muted small">Status</div>
                    <div>
                        @if (posting.IsActive)
                        {
                            <span class="badge bg-success">Current</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Ended</span>
                        }
                    </div>
                </div>
                <div class="col-sm-4 col-lg-3">
                    <div class="text-muted small">From Date</div>
                    <div class="fw-semibold">@posting.FromDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-sm-4 col-lg-3">
                    <div class="text-muted small">To Date</div>
                    <div class="fw-semibold">@(posting.ToDate.HasValue ? posting.ToDate.Value.ToString("dd MMM yyyy") : "—")</div>
                </div>
            </div>

            @if (User.IsInRole("Admin") || User.IsInRole("HR"))
            {
                <div class="mt-3">
                    <a asp-action="Edit" asp-route-id="@posting.Id" class="btn btn-warning btn-sm px-3">Edit Posting</a>
                </div>
            }
        </div>
    </div>

    @* ---------- General KPIs: informational only, collapsed by default ---------- *@
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <button class="btn btn-link text-decoration-none p-0 d-flex align-items-center justify-content-between w-100"
                    type="button" data-bs-toggle="collapse" data-bs-target="#generalKpisCollapse"
                    aria-expanded="false" aria-controls="generalKpisCollapse">
                <span>
                    <i class="bi bi-stars text-warning me-2"></i>
                    <strong>General KPIs</strong>
                    <span class="text-muted ms-2">(@Model.GeneralKPIs.Count() — automatically included in every appraisal)</span>
                </span>
                <i class="bi bi-chevron-down"></i>
            </button>

            <div class="collapse mt-3" id="generalKpisCollapse">
                @if (Model.GeneralKPIs.Any())
                {
                    <div class="row">
                        @foreach (var kpi in Model.GeneralKPIs)
                        {
                            <div class="col-lg-4 col-md-6 mb-3">
                                <div class="kpi-card">
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="kpi-icon">
                                            <i class="bi bi-check2-circle"></i>
                                        </div>
                                        <h6 class="mb-0 ms-3 fw-bold">@kpi.Title</h6>
                                    </div>
                                    <p class="text-muted small mb-0">@kpi.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No General KPIs have been created yet.</p>
                }
            </div>
        </div>
    </div>

</div>
