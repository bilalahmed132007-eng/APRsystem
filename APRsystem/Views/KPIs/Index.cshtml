@model IEnumerable<APRsystem.Models.KPI>

@{
    ViewData["Title"] = "KPI Management";
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h1 class="page-title">
            <i class="bi bi-bar-chart-fill me-2"></i>
            KPI Management
        </h1>
        <p class="text-muted mb-0">Define and manage the KPIs used across employee appraisals.</p>
    </div>
    <a asp-action="Create" class="btn-danger-app">
        <i class="bi bi-plus-lg me-1"></i>
        Add New KPI
    </a>
</div>

<div class="dash-card p-0">
    <table class="table app-table mb-0">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Title)</th>
                <th>@Html.DisplayNameFor(model => model.Description)</th>
                <th>@Html.DisplayNameFor(model => model.Weight)</th>
                <th>@Html.DisplayNameFor(model => model.IsGeneral)</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-5">
                        No KPIs have been added yet. Click <strong>"Add New KPI"</strong> to create the first one.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Title)</td>
                        <td class="text-muted">@Html.DisplayFor(modelItem => item.Description)</td>
                        <td>@Html.DisplayFor(modelItem => item.Weight)%</td>
                        <td>
                            @if (item.IsGeneral)
                            {
                                <span class="badge-active">General</span>
                            }
                            else
                            {
                                <span class="badge-inactive">Specific</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-chip btn-chip-view">View</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-chip btn-chip-edit">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-chip btn-chip-delete">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
