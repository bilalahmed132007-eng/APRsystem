@model APRsystem.ViewModels.AuditLogFilterViewModel

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="page-title">
        <i class="bi bi-journal-text me-2"></i>
        Audit Logs
    </h1>
</div>

<div class="audit-filter-card mb-4">
    <form asp-action="Index" method="get" class="row g-3">
        <input type="hidden" name="Searched" value="true" />

        <div class="col-md-3">
            <label class="form-label">User</label>
            <input type="text" name="UserName" value="@Model.UserName" class="form-control" placeholder="Search by user name" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Action</label>
            <select asp-for="Action" asp-items="Model.ActionOptions" class="form-select">
                <option value="">-- All --</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Entity</label>
            <select asp-for="EntityName" asp-items="Model.EntityOptions" class="form-select">
                <option value="">-- All --</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">From</label>
            <input type="date" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>

        <div class="col-md-2">
            <label class="form-label">To</label>
            <input type="date" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>

        <div class="col-md-1 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary w-100" title="Search">
                <i class="bi bi-funnel"></i>
            </button>
        </div>

        <div class="col-12 d-flex justify-content-end">
            <a asp-action="Index" class="btn-chip btn-chip-clear">
                <i class="bi bi-x-circle me-1"></i>Clear Filters
            </a>
        </div>
    </form>
</div>

@if (!Model.Searched)
{
    <div class="audit-table-card">
        <div class="text-center text-muted py-5">
            <i class="bi bi-funnel fs-3 d-block mb-2"></i>
            Apply a filter above to view audit records.
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-muted mb-0">@Model.TotalCount record(s) found.</p>
    </div>

    <div class="audit-table-card">
        <table class="table app-table table-hover mb-0">
            <thead>
                <tr>
                    <th>Date/Time</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Record ID</th>
                    <th>Changed Fields</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Results.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No audit records match the current filters.</td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model.Results)
                    {
                        <tr>
                            <td class="text-nowrap">@log.Timestamp.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>@(log.UserName ?? "System")</td>
                            <td>
                                <span class="audit-badge audit-badge-@(log.Action switch
                                      {
                                          "Created" => "success",
                                          "Updated" => "warning",
                                          "Deleted" => "danger",
                                          _ => "neutral"
                                      })">@log.Action</span>
                            </td>
                            <td>@log.EntityName</td>
                            <td>@log.RecordId</td>
                            <td class="text-truncate" style="max-width: 260px;">@log.ChangedColumns</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@log.Id" class="btn-chip btn-chip-view">View</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination audit-pagination">
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-Page="@p"
                           asp-route-Searched="true"
                           asp-route-UserName="@Model.UserName"
                           asp-route-Action="@Model.Action"
                           asp-route-EntityName="@Model.EntityName"
                           asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

<style>
    .audit-filter-card {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: 20px 20px 4px 20px;
        box-shadow: var(--shadow-sm);
    }

    .audit-table-card {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

        .audit-table-card table {
            margin-bottom: 0;
        }

    .app-table thead th {
        white-space: nowrap;
    }

    .audit-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .audit-badge-success {
        background: var(--status-success-tint);
        color: var(--status-success);
    }

    .audit-badge-warning {
        background: var(--status-warning-tint);
        color: #b5791f;
    }

    .audit-badge-danger {
        background: var(--status-danger-tint);
        color: var(--status-danger);
    }

    .audit-badge-neutral {
        background: var(--status-neutral-tint);
        color: var(--status-neutral);
    }

    .audit-pagination .page-link {
        border-radius: var(--radius-sm);
        margin: 0 3px;
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
    }

    .audit-pagination .page-item.active .page-link {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
    }

    .audit-pagination .page-item:not(.active) .page-link:hover {
        background: var(--bg-card-hover);
    }
</style>