@model APRsystem.Models.AuditLog
@using System.Text.Json

@{
    ViewData["Title"] = "Audit Log Details";

    Dictionary<string, object?>? oldVals = null;
    Dictionary<string, object?>? newVals = null;

    if (!string.IsNullOrEmpty(Model.OldValues))
        oldVals = JsonSerializer.Deserialize<Dictionary<string, object?>>(Model.OldValues);

    if (!string.IsNullOrEmpty(Model.NewValues))
        newVals = JsonSerializer.Deserialize<Dictionary<string, object?>>(Model.NewValues);
}

<h1>Audit Log Details</h1>

<dl class="row">
    <dt class="col-sm-2">Date/Time</dt>
    <dd class="col-sm-10">@Model.Timestamp.ToLocalTime().ToString("yyyy-MM-dd hh:mm:ss tt")</dd>

    <dt class="col-sm-2">User</dt>
    <dd class="col-sm-10">@(Model.UserName ?? "System") @(Model.UserId != null ? $"({Model.UserId})" : "")</dd>

    <dt class="col-sm-2">Action</dt>
    <dd class="col-sm-10">@Model.Action</dd>

    <dt class="col-sm-2">Entity</dt>
    <dd class="col-sm-10">@Model.EntityName</dd>

    <dt class="col-sm-2">Record ID</dt>
    <dd class="col-sm-10">@Model.RecordId</dd>
</dl>

@if (oldVals != null || newVals != null)
{
    <h4>Field Changes</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Field</th>
                <th>Old Value</th>
                <th>New Value</th>
            </tr>
        </thead>
        <tbody>
            @{
                var allKeys = (oldVals?.Keys ?? Enumerable.Empty<string>())
                    .Union(newVals?.Keys ?? Enumerable.Empty<string>());
            }
            @foreach (var key in allKeys)
            {
                <tr>
                    <td>@key</td>
                    <td>@(oldVals != null && oldVals.TryGetValue(key, out var ov) ? ov : "")</td>
                    <td>@(newVals != null && newVals.TryGetValue(key, out var nv) ? nv : "")</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-secondary">Back to List</a>