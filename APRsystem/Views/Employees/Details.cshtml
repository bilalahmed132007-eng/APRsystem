@model APRsystem.ViewModels.EmployeeDetailsViewModel

@{
    ViewData["Title"] = Model.Employee.FullName;

    string InitialsOf(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    var teamTreeModel = new APRsystem.ViewModels.TeamTreeViewModel
    {
        CurrentEmployee = Model.Employee,
        TeamSupervisor = Model.Supervisor,
        GrandSupervisor = Model.GrandSupervisor,

        Teammates = Model.Teammates,
        DirectReports = Model.DirectReports
    };

    bool canViewPostings = Model.CanViewPostings;
}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index">Dashboard</a>
        </li>

        @if (Model.GrandSupervisor != null)
        {
            <li class="breadcrumb-item">
                <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.GrandSupervisor.Id">
                    @Model.GrandSupervisor.FullName
                </a>
            </li>
        }

        @if (Model.Supervisor != null)
        {
            <li class="breadcrumb-item">
                <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.Supervisor.Id">
                    @Model.Supervisor.FullName
                </a>
            </li>
        }

        <li class="breadcrumb-item active" aria-current="page">
            @Model.Employee.FullName
        </li>
    </ol>
</nav>
<div class="row g-4">

    <!-- Middle: Employee Info + Postings -->
    <div class="col-lg-4">
        <div class="tab-content" id="employeeTabsContent">

            <div class="tab-pane fade show active" id="overview-pane" role="tabpanel">
                <div class="dashboard-card text-start profile-card">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="employee-avatar" style="width:64px;height:64px;font-size:22px;flex-shrink:0;">
                            @InitialsOf(Model.Employee.FullName)
                        </div>
                        <div class="min-w-0">
                            <h4 class="mb-1">@Model.Employee.FullName</h4>
                            <span class="@(Model.Employee.IsActive ? "badge-active" : "badge-inactive")">
                                @(Model.Employee.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                    </div>

                    <div class="profile-field">
                        <div class="profile-field-label">Designation</div>
                        <div class="profile-field-value">@(Model.CurrentPosting?.Designation?.Label ?? "-")</div>
                    </div>
                    <div class="profile-field">
                        <div class="profile-field-label">Department</div>
                        <div class="profile-field-value">@(Model.CurrentPosting?.Department?.Name ?? "-")</div>
                    </div>
                    <div class="profile-field">
                        <div class="profile-field-label">Employee No</div>
                        <div class="profile-field-value">@Model.Employee.EmployeeNo</div>
                    </div>
                    <div class="profile-field">
                        <div class="profile-field-label">Joining Date</div>
                        <div class="profile-field-value">@Model.Employee.JoiningDate.ToString("dd MMM yyyy")</div>
                    </div>
                    <div class="profile-field">
                        <div class="profile-field-label">Supervisor</div>
                        <div class="profile-field-value">
                            @if (Model.Supervisor != null)
                            {
                                <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.Supervisor.Id">
                                    @Model.Supervisor.FullName
                                </a>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </div>
                    </div>
                    <div class="profile-field profile-field-last">
                        <div class="profile-field-label">Email</div>
                        <div class="profile-field-value">@Model.Employee.Email</div>
                    </div>

                    @if (canViewPostings)
                    {
                        <a asp-controller="Postings" asp-action="History" asp-route-employeeId="@Model.Employee.Id" class="profile-action-btn">
                            <i class="bi bi-briefcase-fill me-2"></i> Postings
                        </a>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="performance-pane" role="tabpanel">
                <div class="employee-card text-center py-5">
                    <i class="bi bi-clipboard-check" style="font-size: 40px; color: var(--accent);"></i>
                    <p class="text-muted mt-3 mb-0">Performance history for this employee will appear here.</p>
                </div>
            </div>

        </div>
    </div>

    <!-- Right: Team Tree -->
    <div class="col-lg-8">
        <partial name="_TeamTree" model="teamTreeModel" />
    </div>

</div>

<style>
    .profile-field {
        padding: 12px 0;
        border-bottom: 1px solid var(--border-subtle, rgba(15,23,42,0.08));
    }

    .profile-field-last {
        border-bottom: none;
    }

    .profile-field-label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: var(--text-muted, #8792a8);
        margin-bottom: 4px;
    }

    .profile-field-value {
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary, #1e2637);
        line-height: 1.4;
    }

    .profile-action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 20px;
        background: var(--accent, #5b8def);
        color: #fff;
        border: none;
        padding: 10px 18px;
        border-radius: var(--radius-sm, 8px);
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        transition: background .15s ease, transform .15s ease;
    }

        .profile-action-btn:hover {
            background: var(--accent-hover, #4674d6);
            color: #fff;
            transform: translateY(-2px);
        }

    .min-w-0 {
        min-width: 0;
    }
</style>
