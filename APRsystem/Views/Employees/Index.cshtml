@model IEnumerable<APRsystem.Models.Employee>

@{
    ViewData["Title"] = "Employees";

    var totalEmployees = Model.Count();
    var activeEmployees = Model.Count(e => e.IsActive);
    var inactiveEmployees = totalEmployees - activeEmployees;
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Employees</h2>
            <small class="text-muted">Manage all employees in the organization</small>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
        {
            <a asp-action="Create" class="btn btn-danger px-4">
                <i class="bi bi-plus-circle me-2"></i>
                Add Employee
            </a>
        }
    </div>

    <!-- Statistics -->
    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total Employees</h6>
                    <h2 class="fw-bold">@totalEmployees</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Active Employees</h6>
                    <h2 class="fw-bold text-success">@activeEmployees</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Inactive Employees</h6>
                    <h2 class="fw-bold text-danger">@inactiveEmployees</h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Search -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">

            <input type="text"
                   id="employeeSearch"
                   class="form-control"
                   placeholder="Search employee by name, department or designation..." />

        </div>
    </div>

    <!-- Employee Table -->
    <div class="card shadow-sm border-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0" id="employeeTable">

                <thead class="table-light">

                    <tr>
                        <th>Employee</th>
                        <th>Email</th>
                        <th>Department</th>
                        
                        <th>Supervisor</th>
                        <th>Status</th>
                        <th class="text-centre">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        var currentPosting = item.Postings?.FirstOrDefault(p => p.ToDate == null);

                        <tr>

                            <td>

                                <div class="d-flex align-items-center">

                                    <div class="employee-avatar me-3">

                                        @item.FullName.Substring(0, 1).ToUpper()

                                    </div>

                                    <div>

                                        <div class="fw-semibold">

                                            @item.FullName

                                        </div>

                                        <small class="text-muted">

                                            @item.EmployeeNo

                                        </small>

                                    </div>

                                </div>

                            </td>

                            <td>

                                @item.Email

                            </td>

                            <td>

                                @(currentPosting?.Department?.Name ?? "-")

                            </td>

                            

                            <td>

                                @(item.Supervisor?.FullName ?? "-")

                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td class="text-end">

                                <div class="d-inline-flex gap-2">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn-chip btn-chip-view">
                                        View
                                    </a>

                                    @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Supervisor"))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn-chip btn-chip-edit">
                                            Edit
                                        </a>
                                    }

                                    @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                                    {
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn-chip btn-chip-delete">
                                            Delete
                                        </a>
                                    }
                                    @if (User.IsInRole("Supervisor") &&
     ViewBag.SupervisorId != null &&
     item.SupervisorId == (int)ViewBag.SupervisorId)
                                    {
                                        <a asp-controller="Appraisals"
                                           asp-action="Create"
                                           asp-route-employeeId="@item.Id"
                                           class="btn btn-success btn-sm">
                                            <i class="bi bi-play-circle-fill"></i> APR
                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.getElementById("employeeSearch").addEventListener("keyup", function () {

            let filter = this.value.toLowerCase();

            let rows = document.querySelectorAll("#employeeTable tbody tr");

            rows.forEach(function(row){

                row.style.display = row.innerText.toLowerCase().includes(filter)
                    ? ""
                    : "none";

            });

        });

    </script>

}