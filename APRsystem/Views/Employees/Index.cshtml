@model IEnumerable<APRsystem.Models.Employee>

@{
    ViewData["Title"] = "Employees";

    var totalEmployees = Model.Count();
    var activeEmployees = Model.Count(e => e.IsActive);
    var inactiveEmployees = totalEmployees - activeEmployees;
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="page-title">
                <i class="bi bi-people-fill me-2"></i>
                Employee Management
            </h1>
            <p class="text-muted mb-0">Manage all employees in the organization</p>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
        {
            <a asp-action="Create" class="btn-danger-app">
                <i class="bi bi-plus-circle me-2"></i>
                Add Employee
            </a>
        }
    </div>

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="kpi-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Total Employees</h6>
                        <h2 class="fw-bold mb-0">@totalEmployees</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="kpi-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background: var(--status-success-tint); color: var(--status-success);">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Active Employees</h6>
                        <h2 class="fw-bold mb-0" style="color: var(--status-success);">@activeEmployees</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="kpi-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon" style="background: var(--status-danger-tint); color: var(--status-danger);">
                        <i class="bi bi-person-dash-fill"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Inactive Employees</h6>
                        <h2 class="fw-bold mb-0" style="color: var(--status-danger);">@inactiveEmployees</h2>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Search -->
    <div class="dash-card mb-3">
        <div class="input-group">
            <span class="input-group-text" style="background: var(--bg-panel); border: 1px solid var(--border-subtle); border-right: none; color: var(--text-muted);">
                <i class="bi bi-search"></i>
            </span>
            <input type="text"
                   id="employeeSearch"
                   class="form-control"
                   style="border-left: none;"
                   placeholder="Search employee by name, department or designation..." />
        </div>
    </div>

    <!-- Employee Table -->
    <div class="dash-card p-0">
        <div class="table-responsive">
            <table class="table app-table table-hover align-middle mb-0" id="employeeTable">

                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Supervisor</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                No employees found. Click <strong>"Add Employee"</strong> to create the first one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var currentPosting = item.Postings?.FirstOrDefault(p => p.ToDate == null);

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="row-avatar me-3" style="width: 36px; height: 36px; font-size: 14px;">
                                            @item.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@item.FullName</div>
                                            <small class="text-muted">@item.EmployeeNo</small>
                                        </div>
                                    </div>
                                </td>

                                <td class="text-muted">@item.Email</td>

                                <td>@(currentPosting?.Department?.Name ?? "-")</td>

                                <td>@(item.Supervisor?.FullName ?? "-")</td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactive">Inactive</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="d-inline-flex gap-2 align-items-center flex-nowrap">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-chip btn-chip-view">View</a>

                                        @if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Supervisor"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-chip btn-chip-edit">Edit</a>
                                        }

                                        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-chip btn-chip-delete">Delete</a>
                                        }

                                        @if (User.IsInRole("Supervisor") &&
                                            ViewBag.SupervisorId != null &&
                                            item.SupervisorId == (int)ViewBag.SupervisorId)
                                        {
                                            <a asp-controller="Appraisals"
                                               asp-action="Create"
                                               asp-route-employeeId="@item.Id"
                                               class="btn-chip btn-chip-apr">
                                                <i class="bi bi-play-circle-fill me-1"></i>APR
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<style>
    /* New chip variant for the APR action, in the same visual family as the others */
    .btn-chip-apr {
        background: var(--status-success-tint);
        color: var(--status-success);
        border-color: rgba(34, 176, 125, 0.3);
    }

        .btn-chip-apr:hover {
            background: rgba(34, 176, 125, 0.24);
        }
</style>

@section Scripts {
    <script>
        document.getElementById("employeeSearch").addEventListener("keyup", function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll("#employeeTable tbody tr");

            rows.forEach(function (row) {
                row.style.display = row.innerText.toLowerCase().includes(filter)
                    ? ""
                    : "none";
            });
        });
    </script>
}
