@model APRsystem.ViewModels.ContractFilterViewModel

@{
    ViewData["Title"] = "Contracts";
}

<h1>Contracts</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ New Contract</a>
</p>

<div class="audit-filter-card mb-4">
    <form asp-action="Index" method="get" class="row g-3">

        <div class="col-md-4">
            <label class="form-label">Employee Name</label>
            <input type="text" name="EmployeeName" value="@Model.EmployeeName" class="form-control" placeholder="Search by name" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Type</label>
            <select name="Type" asp-items="Model.TypeOptions" class="form-select">
                <option value="">-- All --</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select name="Status" asp-items="Model.StatusOptions" class="form-select">
                <option value="">-- All --</option>
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
                <i class="bi bi-funnel me-1"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>

    </form>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>Employee</th>
            <th>Contract Number</th>
            <th>Type</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Results.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">No contracts match the current filters.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.Results)
            {
                var isExpired = item.EndDate != null && item.EndDate < DateTime.Today;
                <tr>
                    <td>@item.Employee?.FullName</td>
                    <td>@item.ContractNumber</td>
                    <td>@item.Type</td>
                    <td>@item.StartDate.ToString("d")</td>
                    <td>@(item.EndDate != null ? item.EndDate.Value.ToString("d") : "—")</td>
                    <td>
                        @if (!item.IsActive)
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                        else if (isExpired)
                        {
                            <span class="badge bg-danger">Expired</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Renew / Edit</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<style>
    .audit-filter-card {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: 20px;
        box-shadow: var(--shadow-sm);
    }
</style>