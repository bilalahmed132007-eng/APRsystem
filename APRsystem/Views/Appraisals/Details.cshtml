@model APRsystem.Models.Appraisal

@using Microsoft.AspNetCore.Identity
@using APRsystem.Models.Identity
@inject UserManager<ApplicationUser> UserManager
@inject APRsystem.Data.ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Appraisal Details";

    string bandColor = Model.RankingBand switch
    {
        "Outstanding" => "bg-success",
        "Above Expectations" => "bg-primary",
        "Meets Expectations" => "bg-info",
        "Below Expectations" => "bg-warning",
        _ => "bg-danger"
    };

    string RankLabel(string? rank) => rank switch
    {
        "OS" => "Outstanding (OS)",
        "AE" => "Above Expectations (AE)",
        "ME" => "Meets Expectations (ME)",
        "BE" => "Below Expectations (BE)",
        "NI" => "Needs Improvement (NI)",
        _ => "—"
    };

    var currentUserId = UserManager.GetUserId(User);
    var currentEmployee = DbContext.Employees.FirstOrDefault(e => e.ApplicationUserId == currentUserId);

    bool isSupervisor = currentEmployee?.Id == Model.SupervisorId;
    bool isEmployee = currentEmployee?.Id == Model.EmployeeId;
    bool isReviewer = currentEmployee?.Id == Model.ReviewerId;
    bool isHR = User.IsInRole("HR");

    string statusValue = Model.Status.Value;

    string statusBadge = statusValue switch
    {
        "Draft" => "bg-secondary",
        "SelfAssessment" => "bg-info text-dark",
        "SupervisorReview" => "bg-primary",
        "SubmittedForReview" => "bg-warning text-dark",
        "HRReviewed" => "bg-warning",
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };

    // Stage numbering for the appraisal workflow, keyed off the same status value used above.
    // Rejected has no number — it's treated as a terminal exit from the flow rather than a stage.
    // Edit this map if you want different numbers or want to fold/split stages differently.
    int? StageNumber(string status) => status switch
    {
        "Draft" => 1,
        "SelfAssessment" => 2,
        "SupervisorReview" => 3,
        "SubmittedForReview" => 4,
        "HRReviewed" => 5,
        "Approved" => 6,
        _ => null
    };

    var stageNumber = StageNumber(statusValue);
    string statusDisplay = stageNumber.HasValue
        ? $"Stage {stageNumber}: {Model.Status.Label}"
        : Model.Status.Label; // e.g. "Rejected" stays as-is, no stage number

    // Workflow modal helpers — "done" / "current" / "upcoming" / "na" (branch not taken)
    // Note: Stage 3 (Supervisor Review) has two sub-steps (3a read-only, 3b editable)
    // distinguished in the Score view by EditableField, which isn't available on this
    // page's model — so this modal highlights the whole Stage 3 card as current,
    // without splitting 3a/3b.
    string StageState(string key)
    {
        if (statusValue == "Rejected")
        {
            if (key == "Rejected") return "current";
            if (key == "Approved") return "na";
            return "done";
        }
        int? thisNum = StageNumber(key);
        int? curNum = StageNumber(statusValue);
        if (thisNum == null || curNum == null) return "upcoming";
        if (thisNum < curNum) return "done";
        if (thisNum == curNum) return "current";
        return "upcoming";
    }

    (string cls, string label) StatePill(string state) => state switch
    {
        "done" => ("bg-success-subtle text-success", "Completed"),
        "current" => ("bg-primary text-white", "You are here"),
        "na" => ("bg-light text-muted", "Not taken"),
        _ => ("bg-light text-muted", "Upcoming")
    };

    string CardBorderClass(string key)
    {
        var state = StageState(key);
        if (state != "current") return "apr-wf-card";
        var color = key switch { "Approved" => "border-success", "Rejected" => "border-danger", _ => "border-primary" };
        return $"apr-wf-card border-2 {color} shadow-sm";
    }
}

<div class="container py-4">

    <!-- HEADER -->
    <div class="apr-header">
        <div class="apr-header-title">
            <div class="apr-status-row">
                <span class="badge @statusBadge fs-6 px-3 py-2">@statusDisplay</span>
                @if (Model.Reviewer != null)
                {
                    <small class="text-muted">Reviewer: @Model.Reviewer.FullName</small>
                }
            </div>
            <h2>Appraisal — @Model.Employee.FullName</h2>
            <small class="text-muted">
                @Model.FromDate.ToString("dd MMM yyyy") — @Model.ToDate.ToString("dd MMM yyyy")
                &nbsp;•&nbsp; Supervisor: @Model.Supervisor.FullName
            </small>

            @if (statusValue == "Rejected" && !string.IsNullOrEmpty(Model.ReviewerComments))
            {
                <div class="alert alert-danger mt-3 mb-0">
                    <strong>Reviewer feedback:</strong> @Model.ReviewerComments
                </div>
            }
        </div>

        <div class="d-flex flex-column align-items-end gap-2">
            <div class="apr-actions">
                @* Supervisor: allow self-assessment while still Draft *@
                @if (isSupervisor && statusValue == "Draft")
                {
                    <form asp-action="AllowSelfAssessment" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-person-check me-1"></i>Allow Self-Assessment
                        </button>
                    </form>
                }

                @* Employee: score during self-assessment stage *@
                @if (isEmployee && statusValue == "SelfAssessment")
                {
                    <a asp-action="Score" asp-route-id="@Model.Id" class="btn btn-info btn-sm">Complete Self-Assessment</a>
                }

                @* Supervisor: finalize scoring *@
                @if (isSupervisor && statusValue == "SupervisorReview")
                {
                    <a asp-action="Score" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Review &amp; Finalize Scoring</a>

                    @if (Model.SelfAssessmentEnabled)
                    {
                        <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#sendBackModal">
                            Send Back to Employee
                        </button>
                    }
                }
                

@if (isHR || User.IsInRole("Admin"))
{
    <a asp-action="ExportPdf" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
    </a>
}

                @* HR: add remarks after supervisor submits *@
                @if (isHR && statusValue == "SubmittedForReview")
                {
                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#hrReviewModal">
                        Add HR Remarks
                    </button>
                }

                @* Reviewer: approve/reject after HR reviews *@
                @if (isReviewer && statusValue == "HRReviewed")
                {
                    <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#approveModal">
                        Approve
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal">
                        Reject
                    </button>
                }
            </div>

            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#workflowModal">
                <i class="bi bi-diagram-3 me-1"></i>View Workflow
            </button>

            <a asp-controller="Employees" asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-outline-secondary btn-sm">
                ← Back to Employee
            </a>
        </div>
    </div>

    <!-- HR Remarks Modal -->
    @if (isHR && statusValue == "SubmittedForReview")
    {
        <div class="modal fade" id="hrReviewModal" tabindex="-1">
            <div class="modal-dialog">
                <form asp-action="HRReview" asp-route-id="@Model.Id" method="post">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">HR Remarks</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label">HR Remarks</label>
                            <textarea name="hrRemarks" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Approve Modal -->
    @if (isReviewer && statusValue == "HRReviewed")
    {
        <div class="modal fade" id="approveModal" tabindex="-1">
            <div class="modal-dialog">
                <form asp-action="Approve" asp-route-id="@Model.Id" method="post">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Approve Appraisal</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label">Final Reviewer's Remarks</label>
                            <textarea name="reviewerComments" class="form-control mb-3" rows="3"></textarea>

                            <label class="form-label">Final Rank</label>
                            <select name="finalRank" class="form-select mb-3">
                                <option value="">-- Select --</option>
                                <option value="OS">Outstanding (OS)</option>
                                <option value="AE">Above Expectations (AE)</option>
                                <option value="ME">Meets Expectations (ME)</option>
                                <option value="BE">Below Expectations (BE)</option>
                                <option value="NI">Needs Improvement (NI)</option>
                            </select>

                            <label class="form-label">Action Required (if any)</label>
                            <textarea name="actionRequired" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success">Confirm Approve</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Reject Modal -->
    @if (isReviewer && statusValue == "HRReviewed")
    {
        <div class="modal fade" id="rejectModal" tabindex="-1">
            <div class="modal-dialog">
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Reject Appraisal</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label">Reason for rejection</label>
                            <textarea name="reviewerComments" class="form-control mb-3" rows="3" required></textarea>

                            

                            
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Confirm Reject</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- Send Back Modal -->
    @if (isSupervisor && statusValue == "SupervisorReview" && Model.SelfAssessmentEnabled)
    {
        <div class="modal fade" id="sendBackModal" tabindex="-1">
            <div class="modal-dialog">
                <form asp-action="SendBackToEmployee" asp-route-id="@Model.Id" method="post">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Send Back for Re-Assessment</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label">Reason / notes for employee</label>
                            <textarea name="comments" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-warning">Confirm Send Back</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- GENERAL KPIs -->
    <div class="apr-section">
        <div class="apr-section-header">
            <i class="bi bi-list-check"></i>
            <h5>General KPIs</h5>
        </div>
        <div class="apr-section-body">
            <table class="table table-bordered mb-3">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Weight</th>
                        <th>Self Rating</th>
                        @if (!isEmployee)
                        {
                            <th>Supervisor Rating</th>
                        }
                        <th>Score</th>
                        <th>Max</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kpi in Model.AppraisalKPIs.Where(k => k.Section == APRsystem.Models.KPISection.General))
                    {
                        <tr>
                            <td>
                                @kpi.Title
                                <br />
                                <small class="text-muted">@kpi.Description</small>
                            </td>
                            <td>@kpi.Weight</td>
                            <td>@kpi.SelfRating / 4</td>
                            @if (!isEmployee)
                            {
                                <td>@kpi.Rating / 4</td>
                            }
                            <td>@kpi.Score</td>
                            <td>@(kpi.Weight * 4)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="3">Total</td>
                        <td>@Model.GeneralTotalScore</td>
                        <td>@Model.GeneralMaxScore</td>
                    </tr>
                </tfoot>
            </table>
            <dl class="apr-grid mb-0">
                <dt>Employee's Comment</dt>
                <dd>@(string.IsNullOrEmpty(Model.SelfGeneralComment) ? "—" : Model.SelfGeneralComment)</dd>

                <dt>Supervisor's Comment</dt>
                <dd>@(string.IsNullOrEmpty(Model.SupervisorGeneralComment) ? "—" : Model.SupervisorGeneralComment)</dd>
            </dl>
        </div>
    </div>

    <!-- SPECIFIC KPIs -->
    <div class="apr-section">
        <div class="apr-section-header">
            <i class="bi bi-briefcase"></i>
            <h5>Posting-Specific KPIs</h5>
        </div>
        <div class="apr-section-body">
            <table class="table table-bordered mb-3">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Weight</th>
                        <th>Self Rating</th>
                        @if (!isEmployee)
                        {
                            <th>Supervisor Rating</th>
                        }
                        <th>Score</th>
                        <th>Max</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kpi in Model.AppraisalKPIs.Where(k => k.Section == APRsystem.Models.KPISection.Specific))
                    {
                        <tr>
                            <td>
                                @kpi.Title
                                <br />
                                <small class="text-muted">@kpi.Description</small>
                            </td>
                            <td>@kpi.Weight</td>
                            <td>@kpi.SelfRating / 4</td>
                            @if (!isEmployee)
                            {
                                <td>@kpi.Rating / 4</td>
                            }
                            <td>@kpi.Score</td>
                            <td>@(kpi.Weight * 4)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="3">Total</td>
                        <td>@Model.SpecificTotalScore</td>
                        <td>@Model.SpecificMaxScore</td>
                    </tr>
                </tfoot>
            </table>
            <dl class="apr-grid mb-0">
                <dt>Employee's Comment</dt>
                <dd>@(string.IsNullOrEmpty(Model.SelfSpecificComment) ? "—" : Model.SelfSpecificComment)</dd>

                <dt>Supervisor's Comment</dt>
                <dd>@(string.IsNullOrEmpty(Model.SupervisorSpecificComment) ? "—" : Model.SupervisorSpecificComment)</dd>
            </dl>
        </div>
    </div>

    <!-- GRAND TOTAL -->
    <div class="apr-section">
        <div class="apr-section-body apr-total-banner">
            <div>
                <div class="metric-label">Grand Total</div>
                <div class="metric-value">@Model.GrandTotalScore / @Model.GrandMaxScore</div>
            </div>
            <div>
                <div class="metric-label">Percentage</div>
                <div class="metric-value">@Model.Percentage%</div>
            </div>
            <div>
                <div class="metric-label">Ranking</div>
                <span class="badge @bandColor fs-6 px-3 py-2">@Model.RankingBand</span>
            </div>
        </div>
    </div>

    <!-- SECTION 6: Performance Ranking (Supervisor's Recommendation) — hidden from employee -->
    @if (!isEmployee && (!string.IsNullOrEmpty(Model.RecommendationText) || !string.IsNullOrEmpty(Model.RecommendedRank)))
    {
        <div class="apr-section section-ranking">
            <div class="apr-section-header">
                <i class="bi bi-star"></i>
                <h5>Performance Appraisal Ranking</h5>
                <small>Not shared with employee</small>
            </div>
            <div class="apr-section-body">
                <dl class="apr-grid mb-0">
                    <dt>Appraiser's Recommendation</dt>
                    <dd>@(string.IsNullOrEmpty(Model.RecommendationText) ? "—" : Model.RecommendationText)</dd>

                    <dt>Recommended Rank</dt>
                    <dd>@RankLabel(Model.RecommendedRank)</dd>
                </dl>
            </div>
        </div>
    }

    <!-- SECTION 7: Final Ranking (HR + Final Reviewer) -->
    @if (!string.IsNullOrEmpty(Model.HRRemarks) || !string.IsNullOrEmpty(Model.ReviewerComments) || !string.IsNullOrEmpty(Model.FinalRank))
    {
        <div class="apr-section section-final">
            <div class="apr-section-header">
                <i class="bi bi-check2-circle"></i>
                <h5>Final Ranking</h5>
                @if (Model.ReviewedOn.HasValue)
                {
                    <small>Reviewed on @Model.ReviewedOn.Value.ToString("dd MMM yyyy")</small>
                }
            </div>
            <div class="apr-section-body">
                <dl class="apr-grid mb-0">
                    <dt>HR Remarks</dt>
                    <dd>@(string.IsNullOrEmpty(Model.HRRemarks) ? "—" : Model.HRRemarks)</dd>

                    <dt>Final Reviewer's Remarks</dt>
                    <dd>@(string.IsNullOrEmpty(Model.ReviewerComments) ? "—" : Model.ReviewerComments)</dd>

                    <dt>Final Rank</dt>
                    <dd>@RankLabel(Model.FinalRank)</dd>

                    <dt>Action Required</dt>
                    <dd>@(string.IsNullOrEmpty(Model.ActionRequired) ? "—" : Model.ActionRequired)</dd>
                </dl>
            </div>
        </div>
    }

    <!-- HISTORY -->

    <!-- Workflow Modal -->
    <div class="modal fade" id="workflowModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-diagram-3 me-2"></i>Appraisal workflow</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">

                    @{ var s1 = StageState("Draft"); var p1 = StatePill(s1); }
                    <div class="@CardBorderClass("Draft") mb-3">
                        <div class="apr-wf-card-header">
                            <span class="apr-wf-num">1</span>
                            <h6 class="mb-0">Draft</h6>
                            <span class="badge @p1.cls ms-auto">@p1.label</span>
                        </div>
                        <div class="apr-wf-card-body">
                            <div class="apr-wf-row"><span class="apr-wf-label">Who can act</span><span>Supervisor</span></div>
                            <div class="apr-wf-row"><span class="apr-wf-label">Action</span><span>Allow Self-Assessment</span></div>
                            <div class="apr-wf-row"><span class="apr-wf-label">What happens</span><span><code>AllowSelfAssessment</code> → moves to Stage 2</span></div>
                        </div>
                    </div>

                    <div class="text-center text-muted mb-3"><i class="bi bi-arrow-down"></i></div>

                    @{ var s2 = StageState("SelfAssessment"); var p2 = StatePill(s2); }
                    <div class="@CardBorderClass("SelfAssessment") mb-3">
                        <div class="apr-wf-card-header">
                            <span class="apr-wf-num">2</span>
                            <h6 class="mb-0">Self assessment</h6>
                            <span class="badge @p2.cls ms-auto">@p2.label</span>
                        </div>
                        <div class="apr-wf-card-body">
                            <div class="apr-wf-row"><span class="apr-wf-label">Who can act</span><span>Employee</span></div>
                            <div class="apr-wf-row"><span class="apr-wf-label">Action</span><span>Complete Self-Assessment <small class="text-muted">(opens Score view, EditableField = Self)</small></span></div>
                            <div class="apr-wf-row"><span class="apr-wf-label">What happens</span><span>Posts ratings and comments → moves to Stage 3 (3a)</span></div>
                        </div>
                    </div>

                    <div class="text-center text-muted mb-3"><i class="bi bi-arrow-down"></i></div>

                    @{ var s3 = StageState("SupervisorReview"); var p3 = StatePill(s3); }
                    <div class="@CardBorderClass("SupervisorReview") mb-3">
                        <div class="apr-wf-card-header">
                            <span class="apr-wf-num">3</span>
                            <h6 class="mb-0">Supervisor review</h6>
                            <span class="badge @p3.cls ms-auto">@p3.label</span>
                        </div>
                        <div class="apr-wf-card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="apr-wf-subcard">
                                        <div class="apr-wf-subcard-header">
                                            <span class="apr-wf-subnum">3a</span>
                                            <strong>Supervisor review <small class="text-muted">(read-only)</small></strong>
                                        </div>
                                        <div class="apr-wf-row"><span class="apr-wf-label">Who can act</span><span>Supervisor</span></div>
                                        <div class="apr-wf-row"><span class="apr-wf-label">Action</span><span>Approve Self-Assessment <small class="text-muted">(Score view's Review Decision card)</small><br />Revert to Employee / Send Back to Employee <small class="text-muted">(Details and Score views)</small></span></div>
                                        <div class="apr-wf-row"><span class="apr-wf-label">What happens</span><span>
                                            <code>ApproveSelfAssessment</code> → unlocks 3b<br />
                                            <code>SendBackToEmployee</code> → back to Stage 2
                                        </span></div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="apr-wf-subcard">
                                        <div class="apr-wf-subcard-header">
                                            <span class="apr-wf-subnum">3b</span>
                                            <strong>Supervisor review <small class="text-muted">(editable)</small></strong>
                                        </div>
                                        <div class="apr-wf-row"><span class="apr-wf-label">Who can act</span><span>Supervisor</span></div>
                                        <div class="apr-wf-row"><span class="apr-wf-label">Action</span><span>Submit Rating to HR <small class="text-muted">(Score view)</small></span></div>
                                        <div class="apr-wf-row"><span class="apr-wf-label">What happens</span><span>Posts supervisor ratings, comments, recommendation and rank → moves to Stage 4</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-center text-muted mb-3"><i class="bi bi-arrow-down"></i></div>

                    @{ var s4 = StageState("SubmittedForReview"); var p4 = StatePill(s4); }
                    <div class="@CardBorderClass("SubmittedForReview") mb-3">
                        <div class="apr-wf-card-header">
                            <span class="apr-wf-num">4</span>
                            <h6 class="mb-0">Submitted for HR</h6>
                            <span class="badge @p4.cls ms-auto">@p4.label</span>
                        </div>
                        <div class="apr-wf-card-body">
                            <div class="apr-wf-row"><span class="apr-wf-label">Who can act</span><span>HR</span></div>
                            <div class="apr-wf-row"><span class="apr-wf-label">Action</span><span>Add HR Remarks <small class="text-muted">(modal)</small></span></div>
                            <div class="apr-wf-row"><span class="apr-wf-label">What happens</span><span><code>HRReview</code> → moves to Stage 5</span></div>
                        </div>
                    </div>

                    <div class="text-center text-muted mb-3"><i class="bi bi-arrow-down"></i></div>

                    @{ var s5 = StageState("HRReviewed"); var p5 = StatePill(s5); }
                    <div class="@CardBorderClass("HRReviewed") mb-3">
                        <div class="apr-wf-card-header">
                            <span class="apr-wf-num">5</span>
                            <h6 class="mb-0">HR reviewed</h6>
                            <span class="badge @p5.cls ms-auto">@p5.label</span>
                        </div>
                        <div class="apr-wf-card-body">
                            <div class="apr-wf-row"><span class="apr-wf-label">Who can act</span><span>Final Reviewer</span></div>
                            <div class="apr-wf-row"><span class="apr-wf-label">Actions</span><span>
                                <span class="text-success"><i class="bi bi-check-circle me-1"></i>Approve</span> <small class="text-muted">(modal: final remarks, final rank, action required)</small><br />
                                <span class="text-danger"><i class="bi bi-x-circle me-1"></i>Reject</span> <small class="text-muted">(modal: rejection reason)</small>
                            </span></div>
                        </div>
                    </div>

                    <div class="text-center text-muted mb-3"><i class="bi bi-arrow-down"></i></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            @{ var s6 = StageState("Approved"); var p6 = StatePill(s6); }
                            <div class="@CardBorderClass("Approved") border-success-subtle h-100">
                                <div class="apr-wf-card-header">
                                    <span class="apr-wf-num bg-success">6</span>
                                    <h6 class="mb-0">Approved</h6>
                                    <span class="badge @p6.cls ms-auto">@p6.label</span>
                                </div>
                                <div class="apr-wf-card-body">
                                    <div class="apr-wf-row"><span class="apr-wf-label">What happens</span><span>End of workflow <small class="text-muted">(terminal)</small></span></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            @{ var sR = StageState("Rejected"); var pR = StatePill(sR); }
                            <div class="@CardBorderClass("Rejected") border-danger-subtle h-100">
                                <div class="apr-wf-card-header">
                                    <span class="apr-wf-num bg-danger">✕</span>
                                    <h6 class="mb-0">Rejected</h6>
                                    <span class="badge @pR.cls ms-auto">@pR.label</span>
                                </div>
                                <div class="apr-wf-card-body">
                                    <div class="apr-wf-row"><span class="apr-wf-label">What happens</span><span>End of workflow <small class="text-muted">(terminal)</small>; reviewer's feedback shown to employee</span></div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

</div>

