@model IEnumerable<APRsystem.Models.Appraisal>

@{
    ViewData["Title"] = "Performance Appraisals";
    string currentScope = ViewBag.Scope ?? "own";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Performance Appraisals</h2>
            <small class="text-muted">Track appraisal status and progress</small>
        </div>
    </div>

    <ul class="nav nav-pills mb-4">
        <li class="nav-item">
            <a class="nav-link @(currentScope == "own" ? "active" : "")"
               asp-action="Index" asp-route-scope="own">
                <i class="bi bi-person-fill me-1"></i> My Appraisals
            </a>
        </li>

        @if (ViewBag.HasTeam == true)
        {
            <li class="nav-item">
                <a class="nav-link @(currentScope == "team" ? "active" : "")"
                   asp-action="Index" asp-route-scope="team">
                    <i class="bi bi-people-fill me-1"></i> Team Appraisals
                </a>
            </li>
        }

        @if (ViewBag.IsAdminOrHR == true)
        {
            <li class="nav-item">
                <a class="nav-link @(currentScope == "all" ? "active" : "")"
                   asp-action="Index" asp-route-scope="all">
                    <i class="bi bi-diagram-3-fill me-1"></i> All Appraisals
                </a>
            </li>
        }
    </ul>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Supervisor</th>
                        <th>Type</th>
                        <th>Period</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No appraisals found for this filter.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var appraisal in Model)
                        {
                            <tr>
                                <td>@(appraisal.Employee?.FullName ?? "-")</td>
                                <td>@(appraisal.Supervisor?.FullName ?? "-")</td>
                                <td>@appraisal.Type</td>
                                <td>
                                    @appraisal.FromDate.ToString("dd MMM yyyy") &ndash;
                                    @appraisal.ToDate.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@(appraisal.Status?.Label ?? "-")</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@appraisal.Id" class="btn-chip btn-chip-view">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
