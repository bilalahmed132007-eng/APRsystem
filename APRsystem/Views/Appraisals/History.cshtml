@model APRsystem.Models.Appraisal

@{
    ViewData["Title"] = "Appraisal History";

    string statusBadge = Model.Status.Value switch
    {
        "Draft" => "bg-secondary",
        "SelfAssessment" => "bg-info text-dark",
        "SupervisorReview" => "bg-primary",
        "SubmittedForReview" => "bg-warning text-dark",
        "HRReviewed" => "bg-warning",
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="container py-4">

    <div class="apr-header">
        <div class="apr-header-title">
            <div class="apr-status-row">
                <span class="badge @statusBadge fs-6 px-3 py-2">@Model.Status.Label</span>
            </div>
            <h2>Appraisal History — @Model.Employee.FullName</h2>
            <small class="text-muted">
                @Model.FromDate.ToString("dd MMM yyyy") — @Model.ToDate.ToString("dd MMM yyyy")
            </small>
        </div>

        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
            ← Back to Appraisal
        </a>
    </div>

    <div class="apr-section section-history">
        <div class="apr-section-header">
            <i class="bi bi-clock-history"></i>
            <h5>Appraisal History</h5>
        </div>
        <div class="apr-section-body">
            @if (!Model.History.Any())
            {
                <p class="text-muted mb-0">No history yet.</p>
            }
            else
            {
                <table class="table table-sm table-bordered mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Action By</th>
                            <th>Comment</th>
                            <th>Stage</th>
                            <th>Next Stage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.History)
                        {
                            <tr>
                                <td>@h.Timestamp.ToString("dd MMM yyyy, HH:mm")</td>
                                <td>@h.ActionByName (@h.ActionByRole)</td>
                                <td>@h.Comments</td>
                                <td>@h.Stage.Label</td>
                                <td>@(h.NextStage?.Label ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

</div>
