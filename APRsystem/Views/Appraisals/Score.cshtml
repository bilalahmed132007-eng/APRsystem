@model APRsystem.ViewModels.AppraisalScoreViewModel

@using Microsoft.AspNetCore.Identity
@using APRsystem.Models.Identity
@inject UserManager<ApplicationUser> UserManager
@inject APRsystem.Data.ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Score Appraisal";

    var currentUserId = UserManager.GetUserId(User);
    var currentEmployee = DbContext.Employees.FirstOrDefault(e => e.ApplicationUserId == currentUserId);
    bool isSupervisor = currentEmployee?.Id == Model.SupervisorId;
    bool isEmployee = currentEmployee?.Id == Model.EmployeeId;

    bool editingSelf = Model.EditableField == "Self";
    bool editingSupervisor = Model.EditableField == "Supervisor";
    bool readOnly = Model.EditableField == "None";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Appraisal for @Model.EmployeeName</h2>
            <small class="text-muted">
                @Model.FromDate.ToString("dd MMM yyyy") — @Model.ToDate.ToString("dd MMM yyyy")
            </small>
        </div>
    </div>

    <form asp-action="Score" method="post">

        <input type="hidden" asp-for="AppraisalId" />
        <input type="hidden" asp-for="SupervisorId" />
        <input type="hidden" asp-for="EmployeeId" />

        <!-- GENERAL KPIs -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold text-primary">
                    <i class="bi bi-clipboard-check me-2"></i>
                    General KPIs
                </h5>
            </div>
            <div class="card-body">

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Weight</th>
                            <th width="140">Self Rating (0-4)</th>
                            @if (!isEmployee)
                            {
                                <th width="140">Supervisor Rating (0-4)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.GeneralKPIs.Count; i++)
                        {
                            <tr>
                                <td>
                                    <strong>@Model.GeneralKPIs[i].Title</strong>
                                    <br />
                                    <small class="text-muted">@Model.GeneralKPIs[i].Description</small>
                                    <input type="hidden" asp-for="GeneralKPIs[i].Id" />
                                    @* Keep the non-editable side's value posted back unchanged *@
                                    @if (!editingSelf)
                                    {
                                        <input type="hidden" asp-for="GeneralKPIs[i].SelfRating" />
                                    }
                                    @if (!editingSupervisor)
                                    {
                                        <input type="hidden" asp-for="GeneralKPIs[i].Rating" />
                                    }
                                </td>
                                <td>@Model.GeneralKPIs[i].Weight</td>
                                <td>
                                    @if (editingSelf)
                                    {
                                        <input asp-for="GeneralKPIs[i].SelfRating" type="number" min="0" max="4" class="form-control" />
                                    }
                                    else
                                    {
                                        <span>@Model.GeneralKPIs[i].SelfRating</span>
                                    }
                                </td>
                                @if (!isEmployee)
                                {
                                    <td>
                                        @if (editingSupervisor)
                                        {
                                            <input asp-for="GeneralKPIs[i].Rating" type="number" min="0" max="4" class="form-control" />
                                        }
                                        else
                                        {
                                            <span>@Model.GeneralKPIs[i].Rating</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mb-3">
                    @* Show the employee's own comment as read-only reference whenever the
                       current viewer isn't the employee editing their own self-assessment *@
                    @if (!editingSelf)
                    {
                        <label class="form-label">Employee's Comment (General)</label>
                        <div class="form-control bg-light mb-3" style="min-height: 80px; white-space: pre-wrap;">
                            @(string.IsNullOrWhiteSpace(Model.SelfGeneralComment) ? "No comment provided." : Model.SelfGeneralComment)
                        </div>
                    }

                    @if (!isEmployee)
                    {
                        <label asp-for="GeneralComment" class="form-label">Appraiser's Comment (General)</label>
                        @if (readOnly)
                        {
                            <textarea asp-for="GeneralComment" class="form-control" rows="3" readonly></textarea>
                        }
                        else
                        {
                            <textarea asp-for="GeneralComment" class="form-control" rows="3"></textarea>
                        }
                    }
                    else if (editingSelf)
                    {
                        @* Employee is self-assessing: keep GeneralComment posting back unchanged, but don't show it *@
                        <input type="hidden" asp-for="GeneralComment" />
                    }
                </div>

            </div>
        </div>

        <!-- SPECIFIC KPIs -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold text-primary">
                    <i class="bi bi-clipboard-check me-2"></i>
                    Posting-Specific KPIs
                </h5>
            </div>
            <div class="card-body">

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Weight</th>
                            <th width="140">Self Rating (0-4)</th>
                            @if (!isEmployee)
                            {
                                <th width="140">Supervisor Rating (0-4)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.SpecificKPIs.Count; i++)
                        {
                            <tr>
                                <td>
                                    <strong>@Model.SpecificKPIs[i].Title</strong>
                                    <br />
                                    <small class="text-muted">@Model.SpecificKPIs[i].Description</small>
                                    <input type="hidden" asp-for="SpecificKPIs[i].Id" />
                                    @if (!editingSelf)
                                    {
                                        <input type="hidden" asp-for="SpecificKPIs[i].SelfRating" />
                                    }
                                    @if (!editingSupervisor)
                                    {
                                        <input type="hidden" asp-for="SpecificKPIs[i].Rating" />
                                    }
                                </td>
                                <td>@Model.SpecificKPIs[i].Weight</td>
                                <td>
                                    @if (editingSelf)
                                    {
                                        <input asp-for="SpecificKPIs[i].SelfRating" type="number" min="0" max="4" class="form-control" />
                                    }
                                    else
                                    {
                                        <span>@Model.SpecificKPIs[i].SelfRating</span>
                                    }
                                </td>
                                @if (!isEmployee)
                                {
                                    <td>
                                        @if (editingSupervisor)
                                        {
                                            <input asp-for="SpecificKPIs[i].Rating" type="number" min="0" max="4" class="form-control" />
                                        }
                                        else
                                        {
                                            <span>@Model.SpecificKPIs[i].Rating</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mb-3">
                    @if (!editingSelf)
                    {
                        <label class="form-label">Employee's Comment (Posting-Specific)</label>
                        <div class="form-control bg-light mb-3" style="min-height: 80px; white-space: pre-wrap;">
                            @(string.IsNullOrWhiteSpace(Model.SelfSpecificComment) ? "No comment provided." : Model.SelfSpecificComment)
                        </div>
                    }

                    @if (!isEmployee)
                    {
                        <label asp-for="SpecificComment" class="form-label">Appraiser's Comment (Posting-Specific)</label>
                        @if (readOnly)
                        {
                            <textarea asp-for="SpecificComment" class="form-control" rows="3" readonly></textarea>
                        }
                        else
                        {
                            <textarea asp-for="SpecificComment" class="form-control" rows="3"></textarea>
                        }
                    }
                    else if (editingSelf)
                    {
                        @* Employee is self-assessing: keep SpecificComment posting back unchanged, but don't show it *@
                        <input type="hidden" asp-for="SpecificComment" />
                    }
                </div>

            </div>
        </div>

        @* SECTION 6: Performance Appraisal Ranking — Supervisor only, not shared with employee.
           Only shown while the supervisor is actively rating, OR read-only afterward once a
           recommendation actually exists (so it doesn't appear as an empty/disabled block
           during the earlier SupervisorReview approve/revert stage). *@
        @if (isSupervisor && (editingSupervisor || (readOnly && !string.IsNullOrWhiteSpace(Model.RecommendedRank))))
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark">
                    <h5 class="mb-0">Performance Appraisal Ranking</h5>
                    <small class="text-muted">Not shared with employee</small>
                </div>
                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="RecommendationText" class="form-label">Appraiser's Recommendation</label>
                        <textarea asp-for="RecommendationText" class="form-control" rows="3"
                                  placeholder="Clarify reason if recommendation differs from calculated score"
                                  readonly="@(!editingSupervisor)"></textarea>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RecommendedRank" class="form-label">Recommended Rank</label>
                        <select asp-for="RecommendedRank" class="form-select" disabled="@(!editingSupervisor)">
                            <option value="">-- Select --</option>
                            <option value="OS">Outstanding (OS) — 90% and above</option>
                            <option value="AE">Above Expectations (AE) — 75% - 89%</option>
                            <option value="ME">Meets Expectations (ME) — 50% - 74%</option>
                            <option value="BE">Below Expectations (BE) — 30% - 49%</option>
                            <option value="NI">Needs Improvement (NI) — Below 30%</option>
                        </select>
                    </div>

                </div>
            </div>
        }

        @if (!readOnly)
        {
            <button type="submit" class="btn btn-primary px-4">
                @(editingSelf ? "Submit Self-Assessment" : "Submit Rating to HR")
            </button>
        }

    </form>

    @* Read-only state: supervisor is viewing the employee's self-assessment and deciding
       whether to approve it (move to their own rating stage) or send it back to the employee. *@
    @if (readOnly && isSupervisor)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark">
                <h5 class="mb-0">Review Decision</h5>
            </div>
            <div class="card-body d-flex gap-4 flex-wrap">

                <form asp-action="ApproveSelfAssessment" method="post" class="flex-grow-1">
                    <input type="hidden" name="id" value="@Model.AppraisalId" />
                    <div class="mb-2">
                        <label class="form-label">Comments (optional)</label>
                        <textarea name="comments" class="form-control" rows="2"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success">Approve Self-Assessment</button>
                </form>

                <form asp-action="SendBackToEmployee" method="post" class="flex-grow-1">
                    <input type="hidden" name="id" value="@Model.AppraisalId" />
                    <div class="mb-2">
                        <label class="form-label">Comments (required)</label>
                        <textarea name="comments" class="form-control" rows="2" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-outline-danger">Revert to Employee</button>
                </form>

            </div>
        </div>
    }

</div>
