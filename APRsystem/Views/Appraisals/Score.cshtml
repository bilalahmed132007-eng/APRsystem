@model APRsystem.ViewModels.AppraisalScoreViewModel

@using Microsoft.AspNetCore.Identity
@using APRsystem.Models.Identity
@inject UserManager<ApplicationUser> UserManager
@inject APRsystem.Data.ApplicationDbContext DbContext

@{
    ViewData["Title"] = "Score Appraisal";

    var currentUserId = UserManager.GetUserId(User);
    var currentEmployee = DbContext.Employees.FirstOrDefault(e => e.ApplicationUserId == currentUserId);
    bool isSupervisor = currentEmployee?.Id == Model.SupervisorId;
    bool isEmployee = currentEmployee?.Id == Model.EmployeeId;

    bool editingSelf = Model.EditableField == "Self";
    bool editingSupervisor = Model.EditableField == "Supervisor";
    // Employee reviews the supervisor's rating/comments and adds their own closing
    // comment before the appraisal moves on to HR.
    bool editingEmployeeComment = Model.EditableField == "EmployeeComment";
    // Supervisor gives a final rank + comment after seeing the employee's comment.
    // Separate from the RecommendedRank/RecommendationText given earlier alongside KPI scoring.
    bool editingSupervisorRank = Model.EditableField == "SupervisorRank";
    bool readOnly = Model.EditableField == "None";

    // True once the supervisor has actually put something down (rating, recommendation, etc.).
    // Used to distinguish stage 3a (read-only "approve or send back" review, before the
    // supervisor has scored anything — everything on their side is still empty) from stage 3b
    // onward (supervisor is editing, or has already submitted scores). Showing an empty,
    // uneditable star widget / comment box during 3a is confusing, so we gate on this instead
    // of just "!isEmployee".
    bool supervisorHasReviewed = Model.GeneralKPIs.Any(k => k.Rating > 0)
        || Model.SpecificKPIs.Any(k => k.Rating > 0)
        || !string.IsNullOrWhiteSpace(Model.RecommendedRank);

    // Whether the Supervisor Rating column / Appraiser's Comment box should render at all
    // for the current viewer. Previously this was hidden from the employee entirely; the
    // employee now needs to see it from the Employee Comment stage onward (once the
    // supervisor has actually rated), so it's no longer gated on !isEmployee — it just
    // tracks whether the supervisor's side is currently being edited or already has content.
    bool showSupervisorSide = editingSupervisor || supervisorHasReviewed;

    // Whether the supervisor has produced a Recommendation/Rank, and a Final Rank,
    // used to gate read-only visibility of those blocks for the employee.
    bool supervisorHasRecommended = !string.IsNullOrWhiteSpace(Model.RecommendedRank);
    bool supervisorHasFinalRanked = !string.IsNullOrWhiteSpace(Model.SupervisorFinalRank);

    // Renders a 4-star rating widget.
    // - id/name: standard MVC id/name for the underlying int property (from Html.IdFor / Html.NameFor)
    // - value: current rating (0-4)
    // - editable: true = clickable stars + hidden input that posts back the value
    //             false = static display only (posting, if needed, is handled elsewhere)
    string StarRatingHtml(string id, string name, int value, bool editable)
    {
        var sb = new System.Text.StringBuilder();
        var readonlyClass = editable ? "" : " readonly";
        sb.Append("<div class=\"star-rating").Append(readonlyClass)
          .Append("\" data-target=\"").Append(id)
          .Append("\" title=\"").Append(value).Append(" of 4\">");

        for (int s = 1; s <= 4; s++)
        {
            var filled = s <= value;
            sb.Append("<i class=\"bi ").Append(filled ? "bi-star-fill filled" : "bi-star")
              .Append(" star-icon\" data-value=\"").Append(s).Append("\"></i>");
        }
        sb.Append("</div>");

        if (editable)
        {
            sb.Append("<input type=\"hidden\" id=\"").Append(id)
              .Append("\" name=\"").Append(name)
              .Append("\" value=\"").Append(value)
              .Append("\" class=\"star-rating-value\" />");
        }

        return sb.ToString();
    }
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Appraisal for @Model.EmployeeName</h2>
            <small class="text-muted">
                @Model.FromDate.ToString("dd MMM yyyy") — @Model.ToDate.ToString("dd MMM yyyy")
            </small>
        </div>
    </div>

    <form asp-action="Score" method="post">

        <input type="hidden" asp-for="AppraisalId" />
        <input type="hidden" asp-for="SupervisorId" />
        <input type="hidden" asp-for="EmployeeId" />

        <!-- GENERAL KPIs -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold text-primary">
                    <i class="bi bi-clipboard-check me-2"></i>
                    General KPIs
                </h5>
            </div>
            <div class="card-body">

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Weight</th>
                            <th width="140">Self Rating (0-4)</th>
                            @if (showSupervisorSide)
                            {
                                <th width="140">Supervisor Rating (0-4)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.GeneralKPIs.Count; i++)
                        {
                            <tr>
                                <td>
                                    <strong>@Model.GeneralKPIs[i].Title</strong>
                                    <br />
                                    <small class="text-muted">@Model.GeneralKPIs[i].Description</small>
                                    <input type="hidden" asp-for="GeneralKPIs[i].Id" />
                                    @* Keep the non-editable side's value posted back unchanged *@
                                    @if (!editingSelf)
                                    {
                                        <input type="hidden" asp-for="GeneralKPIs[i].SelfRating" />
                                    }
                                    @if (!editingSupervisor)
                                    {
                                        <input type="hidden" asp-for="GeneralKPIs[i].Rating" />
                                    }
                                </td>
                                <td>@Model.GeneralKPIs[i].Weight</td>
                                <td>
                                    @Html.Raw(StarRatingHtml(
                                        Html.IdFor(m => m.GeneralKPIs[i].SelfRating).ToString(),
                                        Html.NameFor(m => m.GeneralKPIs[i].SelfRating).ToString(),
                                        Model.GeneralKPIs[i].SelfRating,
                                        editingSelf))
                                </td>
                                @if (showSupervisorSide)
                                {
                                    <td>
                                        @Html.Raw(StarRatingHtml(
                                            Html.IdFor(m => m.GeneralKPIs[i].Rating).ToString(),
                                            Html.NameFor(m => m.GeneralKPIs[i].Rating).ToString(),
                                            Model.GeneralKPIs[i].Rating,
                                            editingSupervisor))
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mb-3">
                    @* Show the employee's own comment as read-only reference whenever the
                       current viewer isn't the employee editing their own self-assessment *@
                    @if (!editingSelf)
                    {
                        <label class="form-label">Employee's Comment (General)</label>
                        <div class="form-control bg-light mb-3" style="min-height: 80px; white-space: pre-wrap;">
                            @(string.IsNullOrWhiteSpace(Model.SelfGeneralComment) ? "No comment provided." : Model.SelfGeneralComment)
                        </div>
                    }

                    @if (editingSelf)
                    {
                        <label asp-for="SelfGeneralComment" class="form-label">Your Comment (General)</label>
                        <textarea asp-for="SelfGeneralComment" class="form-control" rows="3"></textarea>
                    }
                    else if (showSupervisorSide)
                    {
                        <label asp-for="SupervisorGeneralComment" class="form-label">Appraiser's Comment <span class="text-muted">(optional)</span></label>
                        @if (readOnly || editingEmployeeComment)
                        {
                            <textarea asp-for="SupervisorGeneralComment" class="form-control" rows="3" readonly></textarea>
                        }
                        else
                        {
                            <textarea asp-for="SupervisorGeneralComment" class="form-control" rows="3"></textarea>
                        }
                    }
                </div>

            </div>
        </div>

        <!-- SPECIFIC KPIs -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold text-primary">
                    <i class="bi bi-clipboard-check me-2"></i>
                    Posting-Specific KPIs
                </h5>
            </div>
            <div class="card-body">

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Weight</th>
                            <th width="140">Self Rating (0-4)</th>
                            @if (showSupervisorSide)
                            {
                                <th width="140">Supervisor Rating (0-4)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.SpecificKPIs.Count; i++)
                        {
                            <tr>
                                <td>
                                    <strong>@Model.SpecificKPIs[i].Title</strong>
                                    <br />
                                    <small class="text-muted">@Model.SpecificKPIs[i].Description</small>
                                    <input type="hidden" asp-for="SpecificKPIs[i].Id" />
                                    @if (!editingSelf)
                                    {
                                        <input type="hidden" asp-for="SpecificKPIs[i].SelfRating" />
                                    }
                                    @if (!editingSupervisor)
                                    {
                                        <input type="hidden" asp-for="SpecificKPIs[i].Rating" />
                                    }
                                </td>
                                <td>@Model.SpecificKPIs[i].Weight</td>
                                <td>
                                    @Html.Raw(StarRatingHtml(
                                        Html.IdFor(m => m.SpecificKPIs[i].SelfRating).ToString(),
                                        Html.NameFor(m => m.SpecificKPIs[i].SelfRating).ToString(),
                                        Model.SpecificKPIs[i].SelfRating,
                                        editingSelf))
                                </td>
                                @if (showSupervisorSide)
                                {
                                    <td>
                                        @Html.Raw(StarRatingHtml(
                                            Html.IdFor(m => m.SpecificKPIs[i].Rating).ToString(),
                                            Html.NameFor(m => m.SpecificKPIs[i].Rating).ToString(),
                                            Model.SpecificKPIs[i].Rating,
                                            editingSupervisor))
                                    </td>
                                }
                            </tr>
                            <tr>
                                <td colspan="@(showSupervisorSide ? 4 : 3)">
                                    @if (editingSelf)
                                    {
                                        <textarea asp-for="SpecificKPIs[i].SelfComment"
                                                  class="form-control form-control-sm"
                                                  rows="2"
                                                  placeholder="Comment on this KPI..."></textarea>
                                    }
                                    else
                                    {
                                        <input type="hidden" asp-for="SpecificKPIs[i].SelfComment" />
                                        <label class="form-label small text-muted mb-1">Employee's Comment</label>
                                        <div class="form-control bg-light" style="min-height: 50px; white-space: pre-wrap;">
                                            @(string.IsNullOrWhiteSpace(Model.SpecificKPIs[i].SelfComment) ? "No comment provided." : Model.SpecificKPIs[i].SelfComment)
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mb-3">
                    @if (editingSupervisor)
                    {
                        <label asp-for="SupervisorSpecificComment" class="form-label">Appraiser's Comment <span class="text-muted">(optional)</span></label>
                        <textarea asp-for="SupervisorSpecificComment" class="form-control" rows="3"></textarea>
                    }
                    else if (showSupervisorSide)
                    {
                        <label class="form-label">Supervisor's Comment (Posting-Specific)</label>
                        <div class="form-control bg-light" style="min-height: 80px; white-space: pre-wrap;">
                            @(string.IsNullOrWhiteSpace(Model.SupervisorSpecificComment) ? "No comment provided." : Model.SupervisorSpecificComment)
                        </div>
                    }
                </div>

            </div>
        </div>

        @* Employee Comment stage: employee has now seen the supervisor's ratings and
           comments above (via showSupervisorSide) and adds their own closing comment
           before the appraisal moves on to HR. *@
        @if (isEmployee && editingEmployeeComment)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-semibold text-primary">
                        <i class="bi bi-chat-left-text me-2"></i>
                        Your Comment on the Supervisor's Rating
                    </h5>
                </div>
                <div class="card-body">
                    <label asp-for="EmployeeFinalComment" class="form-label">Comment</label>
                    <textarea asp-for="EmployeeFinalComment" class="form-control" rows="3"
                              placeholder="Add any comments after reviewing your supervisor's rating"></textarea>
                </div>
            </div>
        }

        @* Performance Appraisal Ranking. Supervisor edits it during their scoring stage.
           Employee can now see it read-only once it exists, once the appraisal has moved
           past their own editing stages (EmployeeComment onward). Previously hard-gated to
           isSupervisor only with a "Not shared with employee" label — that's no longer true. *@
        @if (editingSupervisor || ((isSupervisor || isEmployee) && supervisorHasRecommended && (readOnly || editingEmployeeComment || editingSupervisorRank)))
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark">
                    <h5 class="mb-0">Performance Appraisal Ranking</h5>
                </div>
                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="RecommendationText" class="form-label">Supervisor Remarks <span class="text-danger">*</span></label>
                        <textarea asp-for="RecommendationText" class="form-control" rows="3"
                                  placeholder="Clarify reason if recommendation differs from calculated score"
                                  readonly="@(!editingSupervisor)"
                                  required="@(editingSupervisor)"></textarea>
                        <span asp-validation-for="RecommendationText" class="text-danger small"></span>
                    </div>

                </div>
            </div>
        }

        @* Supervisor's Final Rank stage — comes after the employee's comment. Separate from the
           Recommended Rank above (which is filled in earlier, alongside KPI scoring). Rank +
           comment. Now visible read-only to the employee once the appraisal is fully closed out. *@
        @if (editingSupervisorRank || ((isSupervisor || isEmployee) && supervisorHasFinalRanked && readOnly))
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark">
                    <h5 class="mb-0">Supervisor's Final Rank</h5>
                </div>
                <div class="card-body">

                    @if (isSupervisor)
                    {
                        <div class="mb-3">
                            <label class="form-label">Employee's Comment</label>
                            <div class="form-control bg-light" style="min-height: 80px; white-space: pre-wrap;">
                                @(string.IsNullOrWhiteSpace(Model.EmployeeFinalComment) ? "No comment provided." : Model.EmployeeFinalComment)
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="SupervisorFinalRank" class="form-label">Final Rank</label>
                        @if (editingSupervisorRank)
                        {
                            <select asp-for="SupervisorFinalRank" class="form-select">
                                <option value="">-- Select --</option>
                                <option value="OS">Outstanding (OS)</option>
                                <option value="AE">Above Expectations (AE)</option>
                                <option value="ME">Meets Expectations (ME)</option>
                                <option value="BE">Below Expectations (BE)</option>
                                <option value="NI">Needs Improvement (NI)</option>
                            </select>
                        }
                        else
                        {
                            <input type="hidden" asp-for="SupervisorFinalRank" />
                            <div class="form-control bg-light">@Model.SupervisorFinalRank</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="SupervisorRankComment" class="form-label">Comment</label>
                        @if (editingSupervisorRank)
                        {
                            <textarea asp-for="SupervisorRankComment" class="form-control" rows="3"></textarea>
                        }
                        else
                        {
                            <input type="hidden" asp-for="SupervisorRankComment" />
                            <div class="form-control bg-light" style="min-height: 80px; white-space: pre-wrap;">
                                @(string.IsNullOrWhiteSpace(Model.SupervisorRankComment) ? "No comment provided." : Model.SupervisorRankComment)
                            </div>
                        }
                    </div>

                </div>
            </div>
        }

        @if (!readOnly)
        {
            <div class="d-flex gap-2">
                @* Saves whatever's filled in so far, without submitting — no workflow transition,
                   no required-field checks. Comes back to this same page next time. *@
                <button type="submit" asp-action="SaveScoreDraft" formnovalidate class="btn btn-outline-secondary px-4">
                    <i class="bi bi-save me-1"></i>Save Progress
                </button>
                <button type="submit" class="btn btn-primary px-4">
                    @(editingSelf ? "Submit Self-Assessment"
                        : editingSupervisor ? "Submit"
                        : editingEmployeeComment ? "Submit Comment"
                        : editingSupervisorRank ? "Submit Final Rank"
                        : "Submit Rating to HR")
                </button>
            </div>
        }

    </form>

    @* Read-only state: supervisor is viewing the employee's self-assessment and deciding
       whether to approve it (move to their own rating stage) or send it back to the employee. *@
    @if (readOnly && isSupervisor)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark">
                <h5 class="mb-0">Review Decision</h5>
            </div>
            <div class="card-body d-flex gap-4 flex-wrap">

                <form asp-action="ApproveSelfAssessment" method="post" class="flex-grow-1">
                    <input type="hidden" name="id" value="@Model.AppraisalId" />
                    <div class="mb-2">
                        <label class="form-label">Comments (optional)</label>
                        <textarea name="comments" class="form-control" rows="2"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success">Approve Self-Assessment</button>
                </form>

                <form asp-action="SendBackToEmployee" method="post" class="flex-grow-1">
                    <input type="hidden" name="id" value="@Model.AppraisalId" />
                    <div class="mb-2">
                        <label class="form-label">Comments (required)</label>
                        <textarea name="comments" class="form-control" rows="2" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-outline-danger">Revert to Employee</button>
                </form>

            </div>
        </div>
    }

</div>

<style>
    .star-rating {
        display: inline-flex;
        gap: 4px;
        font-size: 1.4rem;
        line-height: 1;
    }

        .star-rating .star-icon {
            color: #d9d9d9;
            transition: color .1s ease-in-out, transform .1s ease-in-out;
        }

            .star-rating .star-icon.filled {
                color: #f5b301;
            }

        /* Only clickable/hoverable when NOT marked readonly */
        .star-rating:not(.readonly) .star-icon {
            cursor: pointer;
        }

            .star-rating:not(.readonly) .star-icon:hover {
                transform: scale(1.15);
            }
</style>

<script>
    (function() {
        function initStarRatings(root) {
            (root || document).querySelectorAll('.star-rating:not(.readonly)').forEach(function(widget) {
                // Avoid double-binding if this init ever runs more than once
                if (widget.dataset.starBound === '1') return;
                widget.dataset.starBound = '1';

                var input = document.getElementById(widget.getAttribute('data-target'));
                if (!input) return;

                var stars = widget.querySelectorAll('.star-icon');

                function render(val) {
                    stars.forEach(function(star) {
                        var v = parseInt(star.getAttribute('data-value'), 10);
                        var isFilled = v <= val;
                        star.classList.toggle('bi-star-fill', isFilled);
                        star.classList.toggle('bi-star', !isFilled);
                        star.classList.toggle('filled', isFilled);
                    });
                    widget.setAttribute('title', val + ' of 4');
                }

                stars.forEach(function(star) {
                    star.addEventListener('mouseenter', function() {
                        render(parseInt(star.getAttribute('data-value'), 10));
                    });

                    star.addEventListener('click', function() {
                        var clicked = parseInt(star.getAttribute('data-value'), 10);
                        var current = parseInt(input.value || '0', 10);
                        // Clicking the star that represents the current value clears the rating back to 0
                        var newVal = (clicked === current) ? 0 : clicked;
                        input.value = newVal;
                        render(newVal);
                    });
                });

                widget.addEventListener('mouseleave', function() {
                    render(parseInt(input.value || '0', 10));
                });
            });
        }

        // Init anything already on the page (normal full page load)
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() { initStarRatings(); });
        } else {
            initStarRatings();
        }

        // Auto-init anything added later — e.g. this view being swapped into the
        // page via AJAX/fetch, a tab panel, or any other dynamic injection.
        // This means nothing else in the app needs to call initStarRatings() manually.
        var observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                mutation.addedNodes.forEach(function(node) {
                    if (node.nodeType !== 1) return; // only element nodes
                    if (node.matches && node.matches('.star-rating')) {
                        initStarRatings(node.parentNode);
                    } else if (node.querySelectorAll) {
                        var found = node.querySelectorAll('.star-rating');
                        if (found.length) initStarRatings(node);
                    }
                });
            });
        });
        observer.observe(document.body, { childList: true, subtree: true });

        window.initStarRatings = initStarRatings;
    })();
</script>
