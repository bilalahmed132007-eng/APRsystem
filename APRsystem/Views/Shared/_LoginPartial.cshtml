@using Microsoft.AspNetCore.Identity
@using APRsystem.Models.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var displayName = User.Identity?.Name ?? "";
    var initials = displayName.Length > 0 ? displayName.Substring(0, 1).ToUpper() : "?";

    <div class="dropdown user-menu">
        <button class="btn user-menu-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="user-avatar">@initials</span>
            <span class="user-menu-name d-none d-sm-inline">@displayName</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end user-menu-dropdown">
            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="bi bi-person me-2"></i> Manage account
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i> Logout
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-sm btn-outline-secondary" asp-area="Identity" asp-page="/Account/Register">Register</a>
        <a class="btn btn-sm auth-cta-btn" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </div>
}

<style>
    .user-menu-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
        border: none;
        background: transparent;
        padding: 6px 10px;
        border-radius: var(--radius-sm, 8px);
    }

        .user-menu-toggle:hover {
            background: #f5f7fb;
        }

        .user-menu-toggle::after {
            margin-left: 4px;
        }

    .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--accent, #5b8def);
        color: #fff;
        font-weight: 600;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .user-menu-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-primary, #1e2637);
    }

    .user-menu-dropdown {
        border-radius: var(--radius-sm, 8px);
        border: 1px solid var(--border-subtle, rgba(15,23,42,0.08));
        box-shadow: 0 8px 24px rgba(15,23,42,0.1);
        min-width: 200px;
        padding: 6px;
    }

        .user-menu-dropdown .dropdown-item {
            border-radius: 6px;
            padding: 8px 10px;
            font-size: 14px;
        }

    .auth-cta-btn {
        background: var(--accent, #5b8def);
        color: #fff;
        border: none;
        font-weight: 600;
    }

        .auth-cta-btn:hover {
            background: var(--accent-hover, #4674d6);
            color: #fff;
        }
</style>