@using APRsystem.Authorization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - APRsystem</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <div class="app-frame">
            <nav class="navbar navbar-expand-xl app-navbar">
                <div class="container-fluid px-4">
                    <a class="navbar-brand app-brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark">A</span> APRsystem
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navMenu">
                        <ul class="navbar-nav mx-auto">
                            @if (User.HasClaim(Permissions.ClaimType, Permissions.RolesManage))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Index">
                                        Admin
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">
                                    Dashboard
                                </a>
                            </li>
                            @if (User.HasClaim(Permissions.ClaimType, Permissions.UsersView))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employees" ? "active" : "")"
                                       asp-controller="Employees" asp-action="Index">
                                        Employees
                                    </a>
                                </li>
                            }
                            @if (User.HasClaim(Permissions.ClaimType, Permissions.PostingsManage))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Postings" ? "active" : "")"
                                       asp-controller="Postings" asp-action="Index">
                                        Postings
                                    </a>
                                </li>
                            }
                            @if (User.HasClaim(Permissions.ClaimType, Permissions.KPIsView))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "KPIs" ? "active" : "")"
                                       asp-controller="KPIs" asp-action="Index">
                                        KPIs
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Meetings" ? "active" : "")" href="#">
                                    Meetings
                                </a>
                            </li>
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                    More

                                </a>

                                <ul class="dropdown-menu">

                                    @if (User.HasClaim(Permissions.ClaimType, Permissions.DepartmentsManage))
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Departments"
                                               asp-action="Index">
                                                Departments
                                            </a>
                                        </li>
                                    }

                                    @if (User.HasClaim(Permissions.ClaimType, Permissions.LookupsManage))
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Lookups"
                                               asp-action="Index">
                                                Lookups
                                            </a>
                                        </li>
                                    }

                                </ul>

                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Appraisals" ? "active" : "")"
                                   asp-controller="Appraisals" asp-action="Index">
                                    Performance
                                </a>
                            </li>
                        </ul>
                        <div class="d-flex align-items-center gap-3">
                            <span class="nav-icon">🔔</span>
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </div>
            </nav>

            <main class="app-content">
                <div class="content-card">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>