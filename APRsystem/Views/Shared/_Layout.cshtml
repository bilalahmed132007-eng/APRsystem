@using APRsystem.Authorization
<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="~/css/theme-soft-pastel.css" />
    <link rel="stylesheet" href="~/css/logo-and-slideshow.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    <link rel="stylesheet" href="~/css/page-transitions.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="~/js/page-transitions.js"></script>
    <script src="~/js/star-rating.js"></script>
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        // Fallback title: if a view forgot to set ViewData["Title"], derive something
        // sensible from the controller/action instead of silently inheriting whatever
        // title happened to be set by a previous page.
        var pageTitle = ViewData["Title"]?.ToString();
        if (string.IsNullOrWhiteSpace(pageTitle))
        {
            pageTitle = currentAction switch
            {
                "Index" => currentController,
                _ => $"{currentAction} {currentController}"
            };
        }
    }
    <div class="app-shell" id="appShell">
        <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="document.getElementById('appShell').classList.remove('sidebar-open'); document.getElementById('appSidebar').classList.remove('open'); this.classList.remove('open');"></div>

        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-brand">
    <div class="brand-text">
        <div class="fw-bold fs-5">APR System</div>
        <small class="text-muted" style="font-size: 0.85rem;">Performance Management</small>
    </div>
</div>

            <ul class="sidebar-nav">
                <li>
                    <a class="sidebar-nav-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a class="sidebar-nav-item @(currentController == "Home" && currentAction == "Team" ? "active" : "")"
                       asp-controller="Home" asp-action="Team">
                        <i class="bi bi-diagram-3"></i>
                        <span>My Organization</span>
                    </a>
                </li>
                @if (User.HasClaim(Permissions.ClaimType, Permissions.UsersView))
                {
                    <li>
                        <a class="sidebar-nav-item @(currentController == "Employees" ? "active" : "")"
                           asp-controller="Employees" asp-action="Index">
                            <i class="bi bi-people"></i>
                            <span>Employees</span>
                        </a>
                    </li>
                }
                @if (User.HasClaim(Permissions.ClaimType, Permissions.PostingsManage))
                {
                    <li>
                        <a class="sidebar-nav-item @(currentController == "Postings" ? "active" : "")"
                           asp-controller="Postings" asp-action="Index">
                            <i class="bi bi-diagram-3"></i>
                            <span>Postings</span>
                        </a>
                    </li>
                }
                @if (User.HasClaim(Permissions.ClaimType, Permissions.ContractsManage))
                {
                    <li>
                        <a class="sidebar-nav-item @(currentController == "Contracts" ? "active" : "")"
                           asp-controller="Contracts" asp-action="Index">
                            <i class="bi bi-file-earmark-text"></i>
                            <span>Contracts</span>
                        </a>
                    </li>
                }
                <li>
                    <a class="sidebar-nav-item @(currentController == "Appraisals" ? "active" : "")"
                       asp-controller="Appraisals" asp-action="Index">
                        <i class="bi bi-clipboard-check"></i>
                        <span>Performance</span>
                    </a>
                </li>
                

                @if (User.HasClaim(Permissions.ClaimType, Permissions.DepartmentsManage) ||
                     User.HasClaim(Permissions.ClaimType, Permissions.LookupsManage) ||
                     User.HasClaim(Permissions.ClaimType, Permissions.RolesManage))
                {
                    <li class="sidebar-section-label">Admin</li>

                    @if (User.HasClaim(Permissions.ClaimType, Permissions.RolesManage))
                    {
                        <li>
                            <a class="sidebar-nav-item @(currentController == "Admin" ? "active" : "")"
                               asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-shield-lock"></i>
                                <span>Admin</span>
                            </a>
                        </li>
                    }
                    @if (User.HasClaim(Permissions.ClaimType, Permissions.DepartmentsManage))
                    {
                        <li>
                            <a class="sidebar-nav-item @(currentController == "Departments" ? "active" : "")"
                               asp-controller="Departments" asp-action="Index">
                                <i class="bi bi-building"></i>
                                <span>Departments</span>
                            </a>
                        </li>
                    }
                    @if (User.HasClaim(Permissions.ClaimType, Permissions.LookupsManage))
                    {
                        <li>
                            <a class="sidebar-nav-item @(currentController == "Lookups" ? "active" : "")"
                               asp-controller="Lookups" asp-action="Index">
                                <i class="bi bi-list-ul"></i>
                                <span>Lookups</span>
                            </a>
                        </li>
                    }
                    @if (User.HasClaim(Permissions.ClaimType, Permissions.PostingsManage))
                    {
                        <li>
                            <a class="sidebar-nav-item @(currentController == "Postings" ? "active" : "")"
                               asp-controller="Appraisals" asp-action="BulkInitiate">
                                <i class="bi bi-diagram-3"></i>
                                <span>Appraisals</span>
                            </a>
                        </li>
                    }
                    @* Audit Log tab *@
                    @if (User.HasClaim(Permissions.ClaimType, Permissions.AuditLogsView))
                    {
                        <li>
                            <a class="sidebar-nav-item @(currentController == "AuditLogs" ? "active" : "")"
                               asp-controller="AuditLogs" asp-action="Index">
                                <i class="bi bi-journal-text"></i>
                                <span>Audit Log</span>
                            </a>
                        </li>
                    }
                    @if (User.HasClaim(Permissions.ClaimType, Permissions.AuditLogsView))
                    {
                        <li>
                            <a class="sidebar-nav-item @(currentController == "Locations" ? "active" : "")"
                               asp-controller="Locations" asp-action="Index">
                                <i class="bi bi-journal-text"></i>
                                <span>Locations</span>
                            </a>
                        </li>
                    }

                }
            </ul>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm border-0 d-none" id="sidebarToggle" type="button"
                            onclick="document.getElementById('appSidebar').classList.toggle('open'); document.getElementById('sidebarBackdrop').classList.toggle('open');"
                            aria-label="Toggle navigation">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <span class="topbar-title">@pageTitle</span>
                </div>

                <img src="~/images/ppaf-logo.png" alt="PPAF logo" class="topbar-logo" />

                <div class="topbar-actions">
                    <div class="dropdown">
                        <button class="btn btn-sm border-0 position-relative" type="button" id="notificationBell"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-bell fs-5 nav-icon"></i>
                            <span id="notificationBadge" class="badge rounded-pill bg-danger d-none"
                                  style="position:absolute; top:0; right:0; font-size:0.6rem;">0</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end p-0" style="width:320px; max-height:400px; overflow-y:auto;"
                            aria-labelledby="notificationBell">
                            <li class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                                <span class="fw-bold small">Notifications</span>
                                <button type="button" class="btn btn-sm btn-link p-0 small" id="markAllReadBtn">Mark all read</button>
                            </li>
                            <li id="notificationList">
                                <div class="text-center text-muted small py-3">Loading...</div>
                            </li>
                        </ul>
                    </div>
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <main class="app-content">
                <div class="content-card">
                    <div id="page-content">
                        @RenderBody()
                    </div>
                </div>
            </main>
        </div>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script src="~/js/page-transitions.js"></script>
    <script>
        // Show the hamburger toggle only when the sidebar is actually collapsed (mobile widths)
        function syncSidebarToggle() {
        var toggle = document.getElementById('sidebarToggle');
        if (window.innerWidth <= 900) {
        toggle.classList.remove('d-none');
        } else {
        toggle.classList.add('d-none');
        document.getElementById('appSidebar').classList.remove('open');
        document.getElementById('sidebarBackdrop').classList.remove('open');
        }
        }
        window.addEventListener('resize', syncSidebarToggle);
        syncSidebarToggle();
    </script>
        <script src="~/js/page-transitions.js"></script>
        <script src="~/js/star-rating.js"></script>
    <script>
        // Notification bell — polls unread count, renders dropdown on open
        (function () {
        const badge = document.getElementById('notificationBadge');
        const list = document.getElementById('notificationList');
        const bell = document.getElementById('notificationBell');
        const markAllBtn = document.getElementById('markAllReadBtn');

        function getAntiForgeryToken() {
        const el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
        }

        async function loadNotifications() {
        try {
        const res = await fetch('/Notifications/Recent');
        const data = await res.json();

        if (data.unreadCount > 0) {
        badge.textContent = data.unreadCount;
        badge.classList.remove('d-none');
        } else {
        badge.classList.add('d-none');
        }

        if (!data.items || data.items.length === 0) {
        list.innerHTML = '<div class="text-center text-muted small py-3">No notifications</div>';
        return;
        }

        list.innerHTML = data.items.map(n => `
        <a href="${n.url || '#'}" class="d-block px-3 py-2 border-bottom text-decoration-none text-dark notification-item"
        data-id="${n.id}" style="background:${n.isRead ? 'transparent' : '#f5f8ff'};">
        <div class="small">${n.message}</div>
        <div class="text-muted" style="font-size:0.7rem;">${n.createdAt}</div>
        </a>
        `).join('');

        document.querySelectorAll('.notification-item').forEach(item => {
        item.addEventListener('click', async function () {
        const id = this.dataset.id;
        await fetch('/Notifications/MarkRead/' + id, {
        method: 'POST',
        headers: { 'RequestVerificationToken': getAntiForgeryToken() }
        });
        });
        });
        } catch (err) {
        list.innerHTML = '<div class="text-center text-muted small py-3">Could not load notifications</div>';
        }
        }

        bell.addEventListener('click', loadNotifications);

        markAllBtn.addEventListener('click', async function (e) {
        e.stopPropagation();
        await fetch('/Notifications/MarkAllRead', {
        method: 'POST',
        headers: { 'RequestVerificationToken': getAntiForgeryToken() }
        });
        loadNotifications();
        });

        // Initial badge check on page load (without opening dropdown)
        loadNotifications();
        })();
    </script>
</body>
</html>
