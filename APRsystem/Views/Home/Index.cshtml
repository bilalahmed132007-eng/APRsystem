@using APRsystem.Authorization
@model APRsystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-welcome mb-4">
    <p class="dashboard-welcome-greeting mb-1">
        Welcome back, <strong>@User.Identity?.Name</strong>
    </p>
    <p class="dashboard-welcome-subtext mb-0">
        @if (Model.IsAdminOrHR)
        {
            <span>Manage your organization's HR and Performance Management System.</span>
        }
        else if (Model.IsSupervisor)
        {
            <span>Overview of your team.</span>
        }
        else
        {
            <span>Your personal workspace.</span>
        }
    </p>
</div>

@* Employee Info + Team Tree — the first thing Employee/Supervisor users see *@
@if (!Model.IsAdminOrHR && Model.TeamTree?.CurrentEmployee != null)
{
    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <partial name="_EmployeeInfoCard" model="Model.TeamTree.CurrentEmployee" />
        </div>
        <div class="col-lg-8">
            <partial name="_TeamTree" model="Model.TeamTree" />
        </div>
    </div>
}


@if (Model.IsAdminOrHR)
{
    <h5 class="mt-4 mb-3">
        <i class="bi bi-speedometer2 me-2"></i>
        Organization Statistics
    </h5>

    <div class="row g-4">

        <div class="col-lg-4 col-md-6">
            <a asp-controller="Employees" asp-action="Index" class="text-decoration-none">
                <div class="stat-card">
                    <div class="stat-card-icon"><i class="bi bi-people-fill"></i></div>
                    <div class="stat-card-body">
                        <div class="stat-card-value">@Model.EmployeeCount</div>
                        <div class="stat-card-label">Employees</div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-lg-4 col-md-6">
            <a asp-controller="Postings" asp-action="Index" class="text-decoration-none">
                <div class="stat-card">
                    <div class="stat-card-icon"><i class="bi bi-briefcase-fill"></i></div>
                    <div class="stat-card-body">
                        <div class="stat-card-value">@Model.PostingCount</div>
                        <div class="stat-card-label">Postings</div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-lg-4 col-md-6">
            <a asp-controller="KPIs" asp-action="Index" class="text-decoration-none">
                <div class="stat-card">
                    <div class="stat-card-icon"><i class="bi bi-bullseye"></i></div>
                    <div class="stat-card-body">
                        <div class="stat-card-value">@Model.KpiCount</div>
                        <div class="stat-card-label">KPIs</div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-lg-4 col-md-6">
            <a asp-controller="Contracts" asp-action="Index" class="text-decoration-none">
                <div class="stat-card">
                    <div class="stat-card-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                    <div class="stat-card-body">
                        <div class="stat-card-value">@Model.ContractCount</div>
                        <div class="stat-card-label">Contracts</div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-lg-4 col-md-6">
            <a asp-controller="Departments" asp-action="Index" class="text-decoration-none">
                <div class="stat-card">
                    <div class="stat-card-icon"><i class="bi bi-diagram-3-fill"></i></div>
                    <div class="stat-card-body">
                        <div class="stat-card-value">@Model.DepartmentCount</div>
                        <div class="stat-card-label">Departments</div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-lg-4 col-md-6">
            <a asp-controller="Lookups" asp-action="Index" class="text-decoration-none">
                <div class="stat-card">
                    <div class="stat-card-icon"><i class="bi bi-list-ul"></i></div>
                    <div class="stat-card-body">
                        <div class="stat-card-value">@Model.LookupCount</div>
                        <div class="stat-card-label">Lookups</div>
                    </div>
                </div>
            </a>
        </div>

    </div>
}

